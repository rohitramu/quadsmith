environment: "staging"
gcp_project_id: "quadsmith-staging"
registry_region: "us-central1"

regions {
  region: "us-central1"
  db_tier: "db-f1-micro"
  nodes {
    zone: "us-central1-a"
    machine_type: "e2-micro"
  }
}

db_backup_retention_count: 3

rollout {
  health_check_timeout {
    seconds: 30
  }
  drain_timeout {
    seconds: 15
  }
  node_rollout_timeout {
    seconds: 180
  }
  max_retries: 3
  retry_backoff {
    seconds: 5
  }
  ramp_stages {
    candidate_weight_percent: 25
    hold_duration {
      seconds: 5
    }
  }
  ramp_stages {
    candidate_weight_percent: 50
    hold_duration {
      seconds: 5
    }
  }
  ramp_stages {
    candidate_weight_percent: 100
    hold_duration {
      seconds: 0
    }
  }
}
