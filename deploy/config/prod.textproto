environment: "prod"
gcp_project_id: "quadsmith-prod"
registry_region: "us-central1"

regions {
  region: "us-central1"
  db_tier: "db-f1-micro"
  nodes {
    zone: "us-central1-a"
    machine_type: "e2-micro"
  }
}

db_backup_retention_count: 5

rollout {
  health_check_timeout {
    seconds: 30
  }
  drain_timeout {
    seconds: 30
  }
  node_rollout_timeout {
    seconds: 10800
  }
  max_retries: 3
  retry_backoff {
    seconds: 5
  }
  ramp_stages {
    candidate_weight_percent: 1
    hold_duration {
      seconds: 900
    }
  }
  ramp_stages {
    candidate_weight_percent: 5
    hold_duration {
      seconds: 900
    }
  }
  ramp_stages {
    candidate_weight_percent: 10
    hold_duration {
      seconds: 1800
    }
  }
  ramp_stages {
    candidate_weight_percent: 25
    hold_duration {
      seconds: 1800
    }
  }
  ramp_stages {
    candidate_weight_percent: 50
    hold_duration {
      seconds: 3600
    }
  }
  ramp_stages {
    candidate_weight_percent: 100
    hold_duration {
      seconds: 0
    }
  }
}
