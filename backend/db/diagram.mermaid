erDiagram
    builds {
        UUID uuid PK
        TEXT id UK
        TEXT name
        TEXT description
        UUID frame_uuid FK
        UUID motor_uuid FK
        UUID battery_uuid FK
        UUID flight_controller_uuid FK
        UUID propeller_uuid FK
    }

    motors {
        UUID uuid PK
        TEXT id UK
        TEXT manufacturer
        TEXT name
        DECIMAL weight_g
        DECIMAL stator_diameter_mm
        DECIMAL stator_height_mm
        INTEGER kv
    }

    frames {
        UUID uuid PK
        TEXT id UK
        TEXT manufacturer
        TEXT name
        DECIMAL weight_g
        DECIMAL wheelbase_mm
        DECIMAL max_prop_size_mm
        TEXT geometry
    }

    batteries {
        UUID uuid PK
        TEXT id UK
        TEXT manufacturer
        TEXT name
        DECIMAL weight_g
        INTEGER capacity_mah
        INTEGER cell_count_s
        TEXT chemistry
        TEXT connector
    }

    flight_controllers {
        UUID uuid PK
        TEXT id UK
        TEXT manufacturer
        TEXT name
        BOOLEAN is_internal_only
        DECIMAL weight_g
        TEXT processor
        TEXT gyro
        UUID internal_esc_uuid FK
        UUID internal_receiver_uuid FK
        UUID internal_vtx_uuid FK
    }

    escs {
        UUID uuid PK
        TEXT id UK
        TEXT manufacturer
        TEXT name
        BOOLEAN is_internal_only
        DECIMAL weight_g
        INTEGER max_motors
        DECIMAL motor_current_max_a
        DECIMAL motor_current_burst_a
        TEXT firmware
    }

    receivers {
        UUID uuid PK
        TEXT id UK
        TEXT manufacturer
        TEXT name
        BOOLEAN is_internal_only
        DECIMAL weight_g
        TEXT protocol
        BIGINT frequency_band_hz
        BOOLEAN has_telemetry
    }

    video_transmitters {
        UUID uuid PK
        TEXT id UK
        TEXT manufacturer
        TEXT name
        BOOLEAN is_internal_only
        DECIMAL weight_g
        TEXT protocol
        INTEGER max_power_mw
        DECIMAL input_voltage_min_v
        DECIMAL input_voltage_max_v
    }

    antennas {
        UUID uuid PK
        TEXT id UK
        TEXT manufacturer
        TEXT name
        BOOLEAN is_internal_only
        DECIMAL weight_g
        TEXT connector
        TEXT polarization
        BIGINT frequency_band_hz
        DECIMAL length_mm
        DECIMAL gain_dbi
    }

    propellers {
        UUID uuid PK
        TEXT id UK
        TEXT manufacturer
        TEXT name
        DECIMAL weight_g
        DECIMAL diameter_mm
        DECIMAL pitch_mm
        INTEGER blades
        TEXT material
    }

    cameras {
        UUID uuid PK
        TEXT id UK
        TEXT manufacturer
        TEXT name
        BOOLEAN is_internal_only
        DECIMAL weight_g
        TEXT protocol
        TEXT sensor_size
        INTEGER width_mm
        DECIMAL lens_size_mm
    }

    builds ||--o| frames : has
    builds ||--o| motors : has
    builds ||--o| batteries : has
    builds ||--o| flight_controllers : has
    builds ||--o| propellers : has

    flight_controllers ||--o| escs : internal_esc
    flight_controllers ||--o| receivers : internal_receiver
    flight_controllers ||--o| video_transmitters : internal_vtx
