#!/bin/bash
set -e

# 1. Check that no binary/ELF executables are staged
echo "Checking for binary executables..."
for f in $(git diff --cached --name-only); do
    if [ -f "$f" ]; then
        case "$f" in
            *.png|*.jpg|*.jpeg|*.gif|*.ico|*.webp|*.wasm)
                ;;
            *)
                if file "$f" | grep -qE "ELF [0-9]+-bit|PE32 executable|Mach-O"; then
                    echo "Error: Binary executable '$f' is staged. Binaries must never be committed to git."
                    exit 1
                fi
                ;;
        esac
    fi
done

# 2. Run make build to format, tidy, verify, and build everything
echo "Running make build..."
make build

# 3. Check that no tracked files were modified and no untracked files were generated
if ! git diff --exit-code > /dev/null 2>&1; then
    echo "Error: Files were modified by formatters/linters/generators during 'make build'."
    echo "Please stage all modified files before committing:"
    git diff --name-only
    exit 1
fi

UNTRACKED_GEN=$(git status --porcelain | grep '^??' || true)
if [ -n "$UNTRACKED_GEN" ]; then
    echo "Error: Found untracked files generated or left unstaged after 'make build':"
    echo "$UNTRACKED_GEN"
    echo "Please stage or clean up these files before committing."
    exit 1
fi

echo "Pre-commit checks passed successfully."
