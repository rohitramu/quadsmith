erDiagram
    antennas {
        UUID uuid PK,FK
        TEXT manufacturer
        BOOLEAN is_internal_only
        DECIMAL weight_g
        TEXT connector
        TEXT polarization
        INTEGER frequency_band_mhz
        DECIMAL length_mm
        DECIMAL gain_dbi
    }

    users {
        UUID uuid PK
        TEXT id
        TEXT role
        TIMESTAMPTZ last_renamed_at
        TIMESTAMPTZ deleted_at
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    user_profiles {
        UUID uuid PK
        UUID user_uuid FK
        TEXT avatar_url
        TEXT bio
        TIMESTAMPTZ updated_at
    }

    user_emails {
        UUID uuid PK
        UUID user_uuid FK
        TEXT email
        BOOLEAN is_primary
        TIMESTAMPTZ created_at
        BOOLEAN verified_via_otp
    }

    user_email_oauth_accounts {
        UUID uuid PK
        UUID user_email_uuid UK,FK
        UUID oauth_account_uuid UK,FK
        TIMESTAMPTZ created_at
    }

    refresh_tokens {
        UUID uuid PK
        UUID user_uuid FK
        TEXT token_hash
        TIMESTAMPTZ expires_at
        TIMESTAMPTZ last_used_at
        TEXT device_hint
        TEXT ip_address
        TEXT location_hint
        TIMESTAMPTZ created_at
    }

    email_otps {
        UUID uuid PK
        TEXT email
        TEXT code_hash
        TIMESTAMPTZ expires_at
        TIMESTAMPTZ used_at
        INTEGER failed_attempts
        TIMESTAMPTZ created_at
        TEXT challenge_id_hash
        TEXT purpose
        UUID requested_by_user_uuid FK
        TEXT ip_address
        TEXT user_agent
        TEXT location_hint
        TEXT status
        TIMESTAMPTZ approved_at
        TIMESTAMPTZ denied_at
    }

    username_histories {
        UUID uuid PK
        UUID user_uuid FK
        TEXT old_username
        TIMESTAMPTZ renamed_at
        TIMESTAMPTZ first_archived_at
        TIMESTAMPTZ release_warning_sent_at
    }

    oauth_accounts {
        UUID uuid PK
        UUID user_uuid FK
        TEXT provider
        TEXT provider_account_id
        TEXT access_token
        TEXT refresh_token
        TIMESTAMPTZ token_expires_at
        TIMESTAMPTZ created_at
    }

    batteries {
        UUID uuid PK,FK
        TEXT manufacturer
        DECIMAL weight_g
        INTEGER capacity_mah
        INTEGER cell_count_s
        TEXT chemistry
        TEXT connector
        DECIMAL min_voltage
        DECIMAL max_voltage
        DECIMAL max_current_a
    }

    blobs {
        UUID uuid PK
        TEXT id
        TEXT filename
        TEXT mime_type
        BIGINT size_bytes
        BYTEA bytes
        UUID user_uuid FK
        TIMESTAMPTZ created_at
    }

    blob_references {
        UUID uuid PK
        TEXT id
        UUID blob_uuid UK,FK
        TEXT entity_type UK
        UUID entity_uuid UK,FK
        UUID user_uuid UK,FK
        TIMESTAMPTZ created_at
    }

    builds {
        UUID uuid PK,FK
        UUID frame_uuid FK
        UUID motor_uuid FK
        UUID flight_controller_uuid FK
        UUID_ARRAY electronic_speed_controller_uuids
        UUID_ARRAY receiver_uuids
        UUID_ARRAY antenna_uuids
        UUID propeller_uuid FK
        UUID_ARRAY camera_uuids
        UUID video_transmitter_uuid FK
        UUID gps_receiver_uuid FK
    }

    cameras {
        UUID uuid PK,FK
        TEXT manufacturer
        BOOLEAN is_internal_only
        DECIMAL weight_g
        TEXT protocol
        TEXT sensor_size
        TEXT camera_mount_interface
        DECIMAL lens_size_mm
    }

    chargers {
        UUID uuid PK,FK
        TEXT manufacturer
        DECIMAL weight_g
        INTEGER channels
        DECIMAL max_charge_power_w
        DECIMAL max_charge_current_a
        TEXT input_voltage_range
        TEXT supported_chemistries
        INTEGER max_cells_s
    }

    electronic_speed_controllers {
        UUID uuid PK,FK
        TEXT manufacturer
        BOOLEAN is_internal_only
        DECIMAL weight_g
        INTEGER max_motors
        DECIMAL motor_current_max_a
        DECIMAL motor_current_burst_a
        TEXT firmware
        DECIMAL min_voltage
        DECIMAL max_voltage
    }

    flight_controllers {
        UUID uuid PK,FK
        TEXT manufacturer
        BOOLEAN is_internal_only
        DECIMAL weight_g
        TEXT processor
        TEXT gyro
        UUID internal_electronic_speed_controller_uuid FK
        UUID internal_receiver_uuid FK
        UUID internal_video_transmitter_uuid FK
        DECIMAL min_voltage
        DECIMAL max_voltage
        TEXT_ARRAY vtx_ports
        DECIMAL vtx_voltage_min_v
        DECIMAL vtx_voltage_max_v
        TEXT mount_pattern
    }

    frames {
        UUID uuid PK,FK
        TEXT manufacturer
        DECIMAL weight_g
        DECIMAL wheelbase_mm
        DECIMAL max_prop_size_mm
        TEXT geometry
        INTEGER motor_count
        TEXT_ARRAY camera_mount_interfaces
        TEXT_ARRAY motor_mount_patterns
        TEXT_ARRAY board_mount_patterns
    }

    gps_receivers {
        UUID uuid PK,FK
        TEXT manufacturer
        BOOLEAN is_internal_only
        DECIMAL weight_g
        TEXT chipset
        TEXT protocol
        TEXT compass
        DECIMAL input_voltage_min_v
        DECIMAL input_voltage_max_v
    }

    motors {
        UUID uuid PK,FK
        TEXT manufacturer
        DECIMAL weight_g
        DECIMAL stator_diameter_mm
        DECIMAL stator_height_mm
        INTEGER kv
        DECIMAL min_voltage
        DECIMAL max_voltage
        DECIMAL max_current_a
        TEXT_ARRAY prop_mount_interfaces
        TEXT mount_pattern
    }

    propellers {
        UUID uuid PK,FK
        TEXT manufacturer
        DECIMAL weight_g
        DECIMAL diameter_mm
        DECIMAL pitch_mm
        INTEGER blades
        TEXT material
        TEXT prop_mount_interface
    }

    receivers {
        UUID uuid PK,FK
        TEXT manufacturer
        BOOLEAN is_internal_only
        DECIMAL weight_g
        TEXT protocol
        INTEGER frequency_band_mhz
        BOOLEAN has_telemetry
        UUID_ARRAY antenna_uuids
    }

    video_transmitters {
        UUID uuid PK,FK
        TEXT manufacturer
        BOOLEAN is_internal_only
        DECIMAL weight_g
        TEXT protocol
        INTEGER max_power_mw
        DECIMAL input_voltage_min_v
        DECIMAL input_voltage_max_v
        UUID_ARRAY antenna_uuids
        TEXT port_type
        TEXT mount_pattern
        INTEGER frequency_band_mhz
        TEXT_ARRAY antenna_connectors
    }

    electronic_speed_controller_firmwares {
        UUID uuid PK,FK
        TEXT manufacturer
        TEXT version
        TEXT protocols
        TEXT pwm_frequency_range
        BOOLEAN is_open_source
    }

    flight_controller_firmwares {
        UUID uuid PK,FK
        TEXT manufacturer
        TEXT version
        TEXT target_architectures
        TEXT supported_protocols
        BOOLEAN is_open_source
        TEXT repository_url
    }

    field_tools {
        UUID uuid PK,FK
        TEXT manufacturer
        DECIMAL weight_g
        TEXT tool_type
        TEXT power_source
    }

    goggles {
        UUID uuid PK,FK
        TEXT manufacturer
        DECIMAL weight_g
        TEXT video_protocol
        TEXT display_type
        TEXT resolution
        DECIMAL fov_deg
        TEXT ipd_range_mm
        TEXT voltage_range
        BOOLEAN dvr_supported
    }

    radio_firmwares {
        UUID uuid PK,FK
        TEXT manufacturer
        TEXT version
        TEXT supported_protocols
        BOOLEAN is_open_source
    }

    entities {
        UUID uuid PK
        TEXT collection UK
        TEXT id UK
        TEXT name
        TEXT description
        TEXT primary_display_image
        JSONB reference_links
        JSONB media
        TEXT author_or_manufacturer
        BOOLEAN is_archived
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
        UUID user_uuid FK
    }

    reviews {
        UUID uuid PK
        TEXT id
        UUID user_uuid UK,FK
        UUID entity_uuid UK,FK
        BOOLEAN is_recommended
        TEXT body
        BOOLEAN is_edited
        TIMESTAMPTZ deleted_at
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
        BOOLEAN is_author_verified_owner
    }

    review_votes {
        UUID uuid PK
        UUID review_uuid UK,FK
        UUID user_uuid UK,FK
        BOOLEAN is_helpful
        TIMESTAMPTZ created_at
    }

    review_comments {
        UUID uuid PK
        UUID review_uuid FK
        UUID user_uuid FK
        TEXT body
        TIMESTAMPTZ deleted_at
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    questions {
        UUID uuid PK
        TEXT id
        UUID user_uuid FK
        UUID entity_uuid FK
        TEXT title
        TEXT body
        INTEGER net_score
        BOOLEAN is_edited
        TIMESTAMPTZ deleted_at
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    answers {
        UUID uuid PK
        UUID question_uuid FK
        UUID user_uuid FK
        TEXT body
