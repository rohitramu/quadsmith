        BOOLEAN is_accepted_by_asker
        BOOLEAN is_author_endorsed
        BOOLEAN is_edited
        TIMESTAMPTZ deleted_at
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
        TIMESTAMPTZ accepted_at
        TIMESTAMPTZ endorsed_at
    }

    question_votes {
        UUID uuid PK
        UUID question_uuid UK,FK
        UUID user_uuid UK,FK
        BOOLEAN is_upvote
        TIMESTAMPTZ created_at
    }

    answer_votes {
        UUID uuid PK
        UUID answer_uuid UK,FK
        UUID user_uuid UK,FK
        BOOLEAN is_upvote
        TIMESTAMPTZ created_at
    }

    question_comments {
        UUID uuid PK
        UUID question_uuid FK
        UUID user_uuid FK
        TEXT body
        TIMESTAMPTZ deleted_at
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    answer_comments {
        UUID uuid PK
        UUID answer_uuid FK
        UUID user_uuid FK
        TEXT body
        TIMESTAMPTZ deleted_at
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    user_reputations {
        UUID uuid PK
        UUID user_uuid UK,FK
        INTEGER score
        TIMESTAMPTZ updated_at
    }

    collections {
        UUID uuid PK
        TEXT id
        UUID user_uuid FK
        TEXT name
        TEXT description
        BOOLEAN is_system_collection
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    collection_items {
        UUID uuid PK
        UUID collection_uuid UK,FK
        UUID entity_uuid UK,FK
        TIMESTAMPTZ created_at
    }

    software_tools {
        UUID uuid PK,FK
        TEXT manufacturer
        TEXT version
        TEXT category
        TEXT platform
    }

    transmitters {
        UUID uuid PK,FK
        TEXT manufacturer
        DECIMAL weight_g
        TEXT rf_protocol
        TEXT operating_system
        TEXT gimbal_type
