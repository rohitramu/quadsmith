        TEXT internal_notes
        TIMESTAMPTZ expires_at
        TIMESTAMPTZ created_at
        TIMESTAMPTZ revoked_at
        UUID revoked_by_user_uuid FK
        TEXT revoke_reason
    }

    banned_emails {
        UUID uuid PK
        UUID ban_uuid FK
        TEXT email
        TIMESTAMPTZ created_at
    }

