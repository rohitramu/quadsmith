erDiagram
    jit_grants {
        UUID uuid PK
        TEXT id UK
        TEXT token_hash
        TEXT operator
        TEXT operator_type
        TEXT reason
        TEXT operation
        TEXT status
        INTEGER hours
        TIMESTAMPTZ expires_at
        TIMESTAMPTZ created_at
        TIMESTAMPTZ extended_at
        TIMESTAMPTZ revoked_at
    }

    internal_tokens {
        UUID uuid PK
        TEXT id UK
        TEXT name
        TEXT type
        TEXT group_name
        TEXT token_hash
        TIMESTAMPTZ expires_at
        TIMESTAMPTZ created_at
        TIMESTAMPTZ revoked_at
    }

    internal_api_calls {
        UUID uuid PK
        TEXT id UK
        TEXT method
        TEXT caller
        TEXT caller_type
        TEXT group_name
        TEXT jit_grant_id
        TEXT status
        TEXT error_message
        BIGINT duration_ms
        TIMESTAMPTZ created_at
    }

    background_jobs {
        UUID uuid PK
        TEXT job_type
        JSONB payload
        TEXT status
        TEXT unique_key
        INTEGER max_attempts
        TIMESTAMPTZ scheduled_at
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    background_job_attempts {
        UUID uuid PK
        UUID job_uuid FK
        INTEGER attempt_number
        TEXT worker_id
        TIMESTAMPTZ started_at
        TIMESTAMPTZ completed_at
        TEXT status
        TEXT error_message
    }

    background_jobs ||--o{ background_job_attempts : has
