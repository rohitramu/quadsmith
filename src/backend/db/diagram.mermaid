erDiagram
    builds {
        UUID uuid PK
        TEXT id UK
        TEXT name
        TEXT description
        UUID frame_uuid FK
        UUID motor_uuid FK
        UUID battery_uuid FK
        UUID flight_controller_uuid FK
        UUID propeller_uuid FK
        UUID video_transmitter_uuid FK
        UUID gps_receiver_uuid FK
        JSONB reference_links
    }

    motors {
        UUID uuid PK
        TEXT id UK
        TEXT manufacturer
        TEXT name
        DECIMAL weight_g
        DECIMAL stator_diameter_mm
        DECIMAL stator_height_mm
        INTEGER kv
        TEXT description
        JSONB reference_links
    }

    frames {
        UUID uuid PK
        TEXT id UK
        TEXT manufacturer
        TEXT name
        DECIMAL weight_g
        DECIMAL wheelbase_mm
        DECIMAL max_prop_size_mm
        TEXT geometry
        TEXT description
        JSONB reference_links
    }

    batteries {
        UUID uuid PK
        TEXT id UK
        TEXT manufacturer
        TEXT name
        DECIMAL weight_g
        INTEGER capacity_mah
        INTEGER cell_count_s
        TEXT chemistry
        TEXT connector
        TEXT description
        JSONB reference_links
    }

    flight_controllers {
        UUID uuid PK
        TEXT id UK
        TEXT manufacturer
        TEXT name
        BOOLEAN is_internal_only
        DECIMAL weight_g
        TEXT processor
        TEXT gyro
        UUID internal_electronic_speed_controller_uuid FK
        UUID internal_receiver_uuid FK
        UUID internal_video_transmitter_uuid FK
        TEXT description
        JSONB reference_links
    }

    electronic_speed_controllers {
        UUID uuid PK
        TEXT id UK
        TEXT manufacturer
        TEXT name
        BOOLEAN is_internal_only
        DECIMAL weight_g
        INTEGER max_motors
        DECIMAL motor_current_max_a
        DECIMAL motor_current_burst_a
        TEXT firmware
        TEXT description
        JSONB reference_links
    }

    receivers {
        UUID uuid PK
        TEXT id UK
        TEXT manufacturer
        TEXT name
        BOOLEAN is_internal_only
        DECIMAL weight_g
        TEXT protocol
        INTEGER frequency_band_mhz
        BOOLEAN has_telemetry
        TEXT description
        JSONB reference_links
    }

    video_transmitters {
        UUID uuid PK
        TEXT id UK
        TEXT manufacturer
        TEXT name
        BOOLEAN is_internal_only
        DECIMAL weight_g
        TEXT protocol
        INTEGER max_power_mw
        DECIMAL input_voltage_min_v
        DECIMAL input_voltage_max_v
        TEXT description
        JSONB reference_links
    }

    antennas {
        UUID uuid PK
        TEXT id UK
        TEXT manufacturer
        TEXT name
        BOOLEAN is_internal_only
        DECIMAL weight_g
        TEXT connector
        TEXT polarization
        INTEGER frequency_band_mhz
        DECIMAL length_mm
        DECIMAL gain_dbi
        TEXT description
        JSONB reference_links
    }

    propellers {
        UUID uuid PK
        TEXT id UK
        TEXT manufacturer
        TEXT name
        DECIMAL weight_g
        DECIMAL diameter_mm
        DECIMAL pitch_mm
        INTEGER blades
        TEXT material
        TEXT description
        JSONB reference_links
    }

    cameras {
        UUID uuid PK
        TEXT id UK
        TEXT manufacturer
        TEXT name
        BOOLEAN is_internal_only
        DECIMAL weight_g
        TEXT protocol
        TEXT sensor_size
        INTEGER width_mm
        DECIMAL lens_size_mm
        TEXT description
        JSONB reference_links
    }

    gps_receivers {
        UUID uuid PK
        TEXT id UK
        TEXT manufacturer
        TEXT name
        BOOLEAN is_internal_only
        DECIMAL weight_g
        TEXT chipset
        TEXT protocol
        BOOLEAN has_compass
        TEXT compass_chip
        DECIMAL input_voltage_min_v
        DECIMAL input_voltage_max_v
        TEXT description
        JSONB reference_links
    }

    builds ||--o| frames : has
    builds ||--o| motors : has
    builds ||--o| batteries : has
    builds ||--o| flight_controllers : has
    builds ||--o| propellers : has
    builds ||--o| video_transmitters : has
    builds ||--o| gps_receivers : has

    flight_controllers ||--o| electronic_speed_controllers : internal_electronic_speed_controller
    flight_controllers ||--o| receivers : internal_receiver
    flight_controllers ||--o| video_transmitters : internal_video_transmitter
