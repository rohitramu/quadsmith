environment: "staging"

server {
  port: 443
  static_dir: "src/frontend/web/app/dist"
  read_timeout {
    seconds: 15
  }
  write_timeout {
    seconds: 15
  }
  idle_timeout {
    seconds: 60
  }
  max_request_bytes: 10485760
}

api_url: "https://staging-api.quadsmith.com"
app_name: "Quadsmith (Staging)"

database {
  url: "${QS_DATABASE_URL}"
  name: "quadsmith_api"
  max_connections: 10
  min_connections: 1
}
