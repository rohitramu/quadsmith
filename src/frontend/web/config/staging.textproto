environment: "staging"

server {
  port: 443
  read_timeout {
    seconds: 15
  }
  write_timeout {
    seconds: 15
  }
  idle_timeout {
    seconds: 60
  }
  max_request_bytes: 10485760
}

static_dir: "src/frontend/web/app/dist"
api_url: "https://staging-api.quadsmith.com"
app_name: "Quadsmith (Staging)"
