environment: "sandbox"

server {
  port: 8080
  read_timeout {
    seconds: 15
  }
  write_timeout {
    seconds: 15
  }
  idle_timeout {
    seconds: 120
  }
  max_request_bytes: 10485760
}

static_dir: "src/react/app-ops-web/dist"
ops_api_url: "http://127.0.0.1:8082"
grafana_url: "http://127.0.0.1:3000"
