environment: "staging"

server {
  port: 443
  read_timeout {
    seconds: 30
  }
  write_timeout {
    seconds: 60
  }
  idle_timeout {
    seconds: 120
  }
  max_request_bytes: 2097152
}

database {
  url: "${QS_DATABASE_URL}"
  name: "quadsmith_api"
  max_connections: 25
  min_connections: 2
}

auth {
  secret: "${QS_AUTH_SECRET}"
  dev_print_otp: false
  secure_cookies: true
  trusted_proxy_hops: 1
  access_token_ttl {
    seconds: 3600
  }
  refresh_token_ttl {
    seconds: 432000
  }
  otp_ttl {
    seconds: 180
  }
  magic_link_ttl {
    seconds: 900
  }
  email_cooldown {
    seconds: 20
  }
  email {
    console {
    }
  }
  oauth {
    web_base_url: "https://staging.quadsmith.net"
    providers {
      google {
        client_id: "${QS_GOOGLE_CLIENT_ID}"
        client_secret: "${QS_GOOGLE_CLIENT_SECRET}"
      }
      github {
        client_id: "${QS_GITHUB_CLIENT_ID}"
        client_secret: "${QS_GITHUB_CLIENT_SECRET}"
      }
      discord {
        client_id: "${QS_DISCORD_CLIENT_ID}"
        client_secret: "${QS_DISCORD_CLIENT_SECRET}"
      }
    }
  }
}
