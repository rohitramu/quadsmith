environment: "prod"

server {
  port: 8080
  read_timeout {
    seconds: 30
  }
  write_timeout {
    seconds: 60
  }
  idle_timeout {
    seconds: 120
  }
  max_request_bytes: 2097152
}

database {
  url: "${QS_DATABASE_URL}"
  name: "quadsmith_api"
  max_connections: 15
  min_connections: 1
}

auth {
  secret: "${QS_AUTH_SECRET}"
  dev_print_otp: false
  secure_cookies: true
  trusted_proxy_hops: 1
  access_token_ttl {
    seconds: 3600
  }
  refresh_token_ttl {
    seconds: 432000
  }
  otp_ttl {
    seconds: 180
  }
  magic_link_ttl {
    seconds: 900
  }
  email_cooldown {
    seconds: 20
  }
  email {
    smtp {
      host: "smtp.resend.com"
      port: 587
      username: "resend"
      password: "${QS_SMTP_PASSWORD}"
      from_address: "Quadsmith Auth <auth@quadsmith.com>"
      reply_to: "support@quadsmith.com"
      require_tls: true
    }
  }
  oauth {
    web_base_url: "https://quadsmith.com"
    providers {
      google {
        client_id: "${QS_GOOGLE_CLIENT_ID}"
        client_secret: "${QS_GOOGLE_CLIENT_SECRET}"
      }
      github {
        client_id: "${QS_GITHUB_CLIENT_ID}"
        client_secret: "${QS_GITHUB_CLIENT_SECRET}"
      }
      discord {
        client_id: "${QS_DISCORD_CLIENT_ID}"
        client_secret: "${QS_DISCORD_CLIENT_SECRET}"
      }
    }
  }
}
