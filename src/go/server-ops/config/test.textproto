environment: "test"

server {
  port: 8080
  read_timeout {
    seconds: 30
  }
  write_timeout {
    seconds: 60
  }
  idle_timeout {
    seconds: 120
  }
  max_request_bytes: 2097152
}

database {
  url: "${QS_DATABASE_URL:-postgres://postgres:postgres@127.0.0.1:5432/quadsmith_api?sslmode=disable}"
  name: "quadsmith_api"
  max_connections: 25
  min_connections: 2
}

internal_database {
  url: "${QS_INTERNAL_DATABASE_URL:-postgres://postgres:postgres@127.0.0.1:5432/quadsmith_ops?sslmode=disable}"
  name: "quadsmith_ops"
  max_connections: 25
  min_connections: 2
}

groups {
  name: "operators"
  description: "Full developer ops permissions"
  allowed_methods: "*"
}

groups {
  name: "robots"
  description: "Automated scheduler and cron permissions"
  allowed_methods: "*"
}

groups {
  name: "viewers"
  description: "Read-only internal operator permissions"
  allowed_methods: "Get*"
  allowed_methods: "List*"
}

bootstrap_tokens {
  id: "test-operator"
  name: "Test Operator Token"
  token: "qs_op_test_token_12345"
  group_name: "operators"
  type: "HUMAN"
}

bootstrap_tokens {
  id: "sandbox-operator"
  name: "Sandbox Operator Token"
  token: "qs_op_sandbox_token_12345"
  group_name: "operators"
  type: "HUMAN"
}

bootstrap_tokens {
  id: "test-viewer"
  name: "Test Viewer Token"
  token: "qs_viewer_test_token_99999"
  group_name: "viewers"
  type: "HUMAN"
}

bootstrap_tokens {
  id: "test-robot"
  name: "Test Robot Token"
  token: "qs_robot_test_token_67890"
  group_name: "robots"
  type: "ROBOT"
}

jit {
  enabled: true
  auto_approve: true
  default_hours: 2
  max_hours: 12
  sensitive_methods: "SeedDatabase"
  sensitive_methods: "RevokeInternalToken"
}

oauth {
  provider: "github"
  client_id: "${QS_OAUTH_CLIENT_ID:-github-test-id}"
  client_secret: "${QS_OAUTH_CLIENT_SECRET:-github-test-secret}"
  allowed_orgs: "quadsmith"
  default_group: "viewers"
}
