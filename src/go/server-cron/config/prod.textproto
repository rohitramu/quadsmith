environment: "prod"

server {
  port: 8084
  read_timeout {
    seconds: 15
  }
  write_timeout {
    seconds: 15
  }
  idle_timeout {
    seconds: 120
  }
  max_request_bytes: 2097152
}

ops_server_url: "https://ops-api.quadsmith.com"
auth_token: "${QS_JOB_SERVER_AUTH_TOKEN}"

cleanup_expired_otps {
  enabled: true
  interval {
    seconds: 21600
  }
}

cleanup_expired_tokens {
  enabled: true
  cron: "0 */12 * * *"
}

cleanup_orphaned_blobs {
  enabled: true
  interval {
    seconds: 600
  }
}

purge_soft_deleted_accounts {
  enabled: true
  interval {
    seconds: 28800
  }
}

send_username_release_warnings {
  enabled: true
  cron: "0 0 * * *"
}
