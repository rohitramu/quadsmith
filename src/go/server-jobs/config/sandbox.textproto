environment: "sandbox"

server {
  port: 8080
  read_timeout {
    seconds: 30
  }
  write_timeout {
    seconds: 60
  }
  idle_timeout {
    seconds: 120
  }
  max_request_bytes: 2097152
}

ops_server_url: "http://127.0.0.1:8082"
auth_token: "${QS_JOB_SERVER_AUTH_TOKEN:-qs_robot_sandbox_token_67890}"

internal_database {
  url: "${QS_INTERNAL_DATABASE_URL:-postgres://postgres:postgres@127.0.0.1:5432/quadsmith_ops?sslmode=disable}"
  name: "quadsmith_ops"
  max_connections: 10
  min_connections: 2
}

cleanup_expired_otps {
  enabled: true
  interval {
    seconds: 21600
  }
}

cleanup_expired_tokens {
  enabled: true
  cron: "0 */12 * * *"
}

cleanup_orphaned_blobs {
  enabled: true
  interval {
    seconds: 300
  }
}

purge_soft_deleted_accounts {
  enabled: true
  interval {
    seconds: 28800
  }
}

send_username_release_warnings {
  enabled: true
  cron: "0 0 * * *"
}

groups {
  name: "operators"
  description: "Full developer ops permissions"
  allowed_methods: "*"
}

groups {
  name: "robots"
  description: "Automated scheduler and cron permissions"
  allowed_methods: "*"
}

groups {
  name: "viewers"
  description: "Read-only internal operator permissions"
  allowed_methods: "Get*"
  allowed_methods: "List*"
}

bootstrap_tokens {
  id: "sandbox-operator"
  name: "Sandbox Operator Token"
  token: "qs_op_sandbox_token_12345"
  group_name: "operators"
  type: "HUMAN"
}

bootstrap_tokens {
  id: "sandbox-viewer"
  name: "Sandbox Viewer Token"
  token: "qs_viewer_sandbox_token_99999"
  group_name: "viewers"
  type: "HUMAN"
}

bootstrap_tokens {
  id: "sandbox-robot"
  name: "Sandbox Robot Token"
  token: "qs_robot_sandbox_token_67890"
  group_name: "robots"
  type: "ROBOT"
}
