environment: "prod"

server {
  port: 8080
  read_timeout {
    seconds: 30
  }
  write_timeout {
    seconds: 60
  }
  idle_timeout {
    seconds: 120
  }
  max_request_bytes: 2097152
}

ops_server_url: "https://ops.quadsmith.com"
auth_token: "${QS_JOB_SERVER_AUTH_TOKEN}"

internal_database {
  url: "${QS_INTERNAL_DATABASE_URL}"
  name: "quadsmith_ops"
  max_connections: 25
  min_connections: 2
}

cleanup_expired_otps {
  enabled: true
  interval {
    seconds: 21600
  }
}

cleanup_expired_tokens {
  enabled: true
  cron: "0 */12 * * *"
}

cleanup_orphaned_blobs {
  enabled: true
  interval {
    seconds: 300
  }
}

database_maintenance {
  enabled: false
  cron: "0 3 * * 0"
  full_vacuum: false
}

purge_soft_deleted_accounts {
  enabled: true
  interval {
    seconds: 28800
  }
}

send_username_release_warnings {
  enabled: true
  cron: "0 0 * * *"
}
