erDiagram
    %% Base Infrastructure
    component {
        int id PK
        varchar model_name
        int release_year "Nullable"
        int release_month "Nullable"
        int release_day "Nullable"
        numeric weight_g "Nullable"
    }
    company {
        int id PK
        varchar name
        varchar website_url
    }
    component_company {
        int id PK
        int component_id FK
        int company_id FK
    }
    component_link {
        int id PK
        int component_id FK
        int company_id FK
        varchar url
        enum link_type "Purchase, Datasheet, STL, Manual, Firmware, Video"
        varchar title
        text description
    }
    battery_chemistry {
        int id PK
        varchar name
        numeric nominal_voltage_per_cell_v
        numeric max_voltage_per_cell_v
        numeric min_voltage_per_cell_v
        text description
    }
    tag {
        int id PK
        varchar name UK "Unique constraint"
        text description "Nullable"
    }

    %% N-Way Exception Tracking
    incompatibility_issue {
        int id PK
        enum incompatibility_reason "Physical, Noise, Electronic, Firmware, Unknown"
        text description "Detailed context on why the pairing fails."
        varchar suggested_fix "Nullable"
    }
    incompatibility_component {
        int issue_id PK, FK "References incompatibility_issue.id"
        int component_id PK, FK "References component.id"
    }

    %% Hardware Subtypes
    frame {
        int id PK, FK
        int wheelbase_mm
        numeric max_prop_size_mm
        varchar[] fc_stack_mount_mm
        varchar[] motor_mount_pattern
        numeric camera_mount_width_mm
        varchar[] vtx_mount_mm
        numeric arm_thickness_mm
        numeric max_battery_length_mm "Nullable"
        numeric max_battery_width_mm "Nullable"
        numeric max_battery_height_mm "Nullable"
    }
    motor {
        int id PK, FK
        varchar stator_size
        int kv_rating
        numeric input_voltage_min_v
        numeric input_voltage_max_v
        varchar mount_pattern_mm
        enum mount_bolt_size "M1.4, M2, M3"
        enum shaft_type "5mm, T-Mount 1.5mm, T-Mount 2mm"
        numeric max_current_a
    }
    propeller {
        int id PK, FK
        numeric diameter_mm
        numeric pitch_mm
        int blade_count
        enum mount_type "5mm Hole, T-Mount M2"
        varchar[] recommended_stator
    }
    flight_controller {
        int id PK, FK
        varchar mount_pattern_mm
        enum mcu_processor "F405, F411, F722, H743"
        varchar gyro_sensor
        numeric input_voltage_min_v
        numeric input_voltage_max_v
        jsonb bec_outputs
        int uart_count
        enum esc_interface "8-pin Plug, Direct Solder"
        varchar[] supported_firmware
    }
    esc {
        int id PK, FK
        boolean is_integrated "True if AIO"
        enum form_factor "4-in-1, Individual"
        varchar mount_pattern_mm
        numeric continuous_current_a
        numeric burst_current_a
        numeric input_voltage_min_v
        numeric input_voltage_max_v
        enum firmware_protocol "BLHeli_S, BLHeli_32, AM32, Bluejay"
    }
    battery {
        int id PK, FK
        int chemistry_id FK
        int cell_count_s
        int capacity_mah
        int continuous_c_rating
        enum connector_type "BT2.0, XT30, XT60"
        numeric length_mm
        numeric width_mm
        numeric height_mm
    }
    vtx_module {
        int id PK, FK
        enum ecosystem "Analog, DJI, Walksnail, HDZero"
        varchar video_connection_standard "e.g., 'Analog CVBS'"
        varchar mount_pattern_mm
        numeric input_voltage_min_v
        numeric input_voltage_max_v
        int max_power_mw
        enum[] antenna_connectors "e.g., ['U.FL', 'U.FL']"
        enum[] included_antenna_polarizations "e.g., ['LHCP', 'LHCP']"
    }
    camera {
        int id PK, FK
        enum ecosystem "Analog, DJI, Walksnail, HDZero"
        varchar video_connection_standard "Matches VTX connection standard"
        numeric width_mm
        numeric height_mm
        numeric depth_mm
        numeric input_voltage_min_v
        numeric input_voltage_max_v
        enum mounting_screw_size "M1.4, M2, M3"
        enum aspect_ratio "4:3, 16:9, Switchable"
    }
    receiver {
        int id PK, FK
        enum rf_protocol "ELRS 2.4, Crossfire, FrSky"
        enum output_protocol "CRSF, SBUS, F.Port"
        numeric input_voltage_min_v
        numeric input_voltage_max_v
        enum[] antenna_connectors "Array e.g., ['U.FL']"
        enum[] included_antenna_polarizations "Array e.g., ['Linear']"
    }
    gps_module {
        int id PK, FK
        varchar chipset
        boolean has_compass
        numeric input_voltage_min_v
        numeric input_voltage_max_v
    }
    antenna {
        int id PK, FK
        enum frequency_band "5.8GHz, 2.4GHz, 900MHz, 1.3GHz"
        enum polarization "LHCP, RHCP, Linear"
        enum connector "U.FL, IPEX4, MMCX, SMA, RP-SMA"
        varchar antenna_style "Omni, Patch, Helical, Dipole"
        numeric gain_dbi
        numeric cable_length_mm
    }

    %% Ground Station Equipment
    transmitter {
        int id PK, FK
        enum rf_protocol "ELRS 2.4, Crossfire, FrSky"
        enum external_bay_type "JR Micro, Lite/Nano, None"
        enum operating_system "EdgeTX, OpenTX, Ethos"
        enum[] antenna_connectors "Array e.g., ['SMA']"
        enum[] included_antenna_polarizations "Array e.g., ['Linear']"
    }
    goggles {
        int id PK, FK
        enum ecosystem "Analog, DJI, Walksnail, HDZero"
        boolean has_analog_bay
        varchar[] video_input
        numeric min_ipd_mm
        numeric max_ipd_mm
        enum[] antenna_connectors "Array e.g., ['SMA', 'RP-SMA']"
        enum[] included_antenna_polarizations "Array e.g., ['LHCP', 'LHCP']"
    }

    %% Sub-Assemblies / Loadouts (Using Integer Arrays)
    vtx_configuration {
        int id PK
        int vtx_id FK "References vtx_module"
        int[] antenna_ids "References antenna.id (Allows duplicates)"
        varchar loadout_name "Nullable. e.g., 'O3 + Dual Matchsticks'"
    }

    receiver_configuration {
        int id PK
        int receiver_id FK "References receiver"
        int[] antenna_ids "References antenna.id (Allows duplicates)"
        varchar loadout_name "Nullable."
    }

    %% Core Application Entity (The Aircraft)
    build {
        int id PK
        varchar name
        int crash_resistance_rating "1 to 10 scale"
        text description
        boolean is_verified

        int[] tag_ids "References tag.id"

        numeric estimated_cost_usd "Nullable"
        numeric dry_weight_g "Scale weight. Nullable."
        numeric all_up_weight_g "Scale weight w/ battery. Nullable."

        int target_battery_cell_count_s
        int target_battery_capacity_mah

        %% Hard Hardware Links
        int frame_id FK
        int motor_id FK
        int propeller_id FK "Replaces target_prop_diameter_mm"
        int fc_id FK
        int esc_id FK
        int camera_id FK
        int gps_id FK "Nullable"

        %% Sub-Assembly Links
        int vtx_config_id FK "Pre-combined VTX + Antennas"
        int receiver_config_id FK "Pre-combined RX + Antennas"

        timestamp created_at
    }

    %% Relationships
    component ||--o{ component_company : "mapped by"
    company ||--o{ component_company : "acts as"
    component ||--o{ component_link : "has"
    company |o--o{ component_link : "hosts"

    component ||--|| frame : "extends"
    component ||--|| motor : "extends"
    component ||--|| propeller : "extends"
    component ||--|| flight_controller : "extends"
    component ||--|| esc : "extends"
    component ||--|| battery : "extends"
    component ||--|| vtx_module : "extends"
    component ||--|| camera : "extends"
    component ||--|| receiver : "extends"
    component ||--|| gps_module : "extends"
    component ||--|| transmitter : "extends"
    component ||--|| goggles : "extends"
    component ||--|| antenna : "extends"

    %% Incompatibility Relationships
    incompatibility_issue ||--o{ incompatibility_component : "involves"
    component ||--o{ incompatibility_component : "is_flagged_in"

    %% Sub-Assembly Relationships
    vtx_module ||--o{ vtx_configuration : "base unit for"
    antenna ||--o{ vtx_configuration : "uses via array"

    receiver ||--o{ receiver_configuration : "base unit for"
    antenna ||--o{ receiver_configuration : "uses via array"

    %% Build Relationships
    battery_chemistry ||--o{ battery : "defines per-cell volts"
    tag ||--o{ build : "categorizes via array"

    frame ||--o{ build : "uses"
    motor ||--o{ build : "uses"
    propeller ||--o{ build : "uses"
    flight_controller ||--o{ build : "uses"
    esc |o--o{ build : "uses"
    camera ||--o{ build : "uses"
    gps_module |o--o{ build : "uses"

    vtx_configuration ||--o{ build : "provides video link"
    receiver_configuration ||--o{ build : "provides control link"