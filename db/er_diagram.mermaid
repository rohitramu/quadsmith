erDiagram
    Component {
        Int id PK "e.g. 1"
        String name "e.g. Betaflight / Caddx Ratel 2"
        Int releaseYear "e.g. 2021"
        Int releaseMonth "e.g. 1"
        Int releaseDay "e.g. 15"
    }

    HardwareComponent {
        Int id PK "e.g. 1"
        Component component FK
        Float weightG "e.g. 5.9"
    }

    SoftwareComponent {
        Int id PK "e.g. 2"
        Component component FK
        String version "e.g. 4.4"
        String softwareType "e.g. Firmware"
    }

    Company {
        Int id PK "e.g. 1"
        String name "e.g. CaddxFPV"
        String websiteUrl "e.g. https://caddxfpv.com"
    }
    ComponentCompany {
        Component component PK
        Company company PK
    }
    ReferenceLink {
        Int id PK "e.g. 1"
        Component component FK
        Company company FK
        String url "e.g. https://..."
        String linkType "e.g. Purchase"
        String title "e.g. Caddx Ratel 2"
        String description "e.g. Product Page"
    }
    Tag {
        Int id PK "e.g. 1"
        String name "e.g. freestyle"
    }

    IncompatibilityIssue {
        Int id PK "e.g. 1"
        String description "e.g. Too tall for frame"
    }
    IncompatibilityComponent {
        IncompatibilityIssue issue PK
        Component component PK
    }

    %% Hardware Specific Models
    Frame {
        Int id PK "e.g. 101"
        HardwareComponent component FK
        Int wheelbaseMm "e.g. 220"
        Float maxPropSizeMm "e.g. 129.5"
        Float cameraMountWidthMm "e.g. 19.0"
        Float maxBatteryLengthMm "e.g. 130.0"
        Float maxBatteryWidthMm "e.g. 40.0"
        Float maxBatteryHeightMm "e.g. 35.0"
    }
    Motor {
        Int id PK "e.g. 102"
        HardwareComponent component FK
        String statorSize "e.g. 2207"
        Int kvRating "e.g. 1950"
        Float shaftDiameterMm "e.g. 5.0"
        String shaftType "e.g. Hollow"
    }
    Propeller {
        Int id PK "e.g. 103"
        HardwareComponent component FK
        Float diameterInches "e.g. 5.1"
        Float pitchInches "e.g. 3.0"
        Int blades "e.g. 3"
        String material "e.g. Polycarbonate"
    }
    FlightController {
        Int id PK "e.g. 104"
        HardwareComponent component FK
        String processor "e.g. F722"
        String gyro "e.g. MPU6000"
        Int uarts "e.g. 5"
        Boolean hasOsd "e.g. true"
        Boolean hasBec "e.g. true"
        Boolean hasBlackbox "e.g. true"
        Boolean hasWifi "e.g. false"
        Boolean hasBluetooth "e.g. false"
        Boolean isAio "e.g. false"
    }
    Esc {
        Int id PK "e.g. 105"
        HardwareComponent component FK
        Int continuousCurrentA "e.g. 50"
        Int burstCurrentA "e.g. 60"
        Float inputVoltageMinV "e.g. 11.1"
        Float inputVoltageMaxV "e.g. 25.2"
        Boolean is4in1 "e.g. true"
        String escInterface "e.g. DSHOT600"
    }
    Battery {
        Int id PK "e.g. 106"
        HardwareComponent component FK
        BatteryChemistry chemistry FK "e.g. LiPo"
        Int cells "e.g. 6"
        Int capacityMah "e.g. 1100"
        Int continuousCRating "e.g. 120"
        BatteryConnector connectorType FK "e.g. XT60"
        Float lengthMm "e.g. 78.0"
        Float widthMm "e.g. 38.0"
        Float heightMm "e.g. 38.0"
    }
    Vtx {
        Int id PK "e.g. 107"
        HardwareComponent component FK
        String videoConnectionStandard "e.g. MIPI, Analog CVBS"
        Float boardHeightMm "e.g. 5.5"
        Float inputVoltageMinV "e.g. 7.4"
        Float inputVoltageMaxV "e.g. 26.4"
        Int maxPowerMw "e.g. 1200"
        Int antennaCount "e.g. 2"
    }
    Camera {
        Int id PK "e.g. 108"
        HardwareComponent component FK
        String videoConnectionStandard "e.g. MIPI"
        Float widthMm "e.g. 19.0"
        Float heightMm "e.g. 19.0"
        Float depthMm "e.g. 24.0"
        Float inputVoltageMinV "e.g. 5.0"
        Float inputVoltageMaxV "e.g. 25.2"
        String mountingScrewSize "e.g. M2"
        String aspectRatio "e.g. 16:9"
    }
    Receiver {
        Int id PK "e.g. 109"
        HardwareComponent component FK
        String outputProtocol "e.g. CRSF, SBUS"
        Float inputVoltageMinV "e.g. 4.5"
        Float inputVoltageMaxV "e.g. 5.5"
        Int antennaCount "e.g. 1"
    }
    Gps {
        Int id PK "e.g. 110"
        HardwareComponent component FK
        String chipset "e.g. M10"
        Boolean hasCompass "e.g. true"
        Float inputVoltageMinV "e.g. 3.3"
        Float inputVoltageMaxV "e.g. 5.5"
    }
    Antenna {
        Int id PK "e.g. 111"
        HardwareComponent component FK
        String antennaStyle "e.g. Omni, Patch"
        Float gainDbi "e.g. 2.5"
        Float cableLengthMm "e.g. 60.0"
    }
    Transmitter {
        Int id PK "e.g. 112"
        HardwareComponent component FK
        String externalBayType "e.g. JR Micro, Lite"
        String operatingSystem "e.g. EdgeTX"
        Int antennaCount "e.g. 1"
    }
    Goggles {
        Int id PK "e.g. 113"
        HardwareComponent component FK
        Int antennaCount "e.g. 4"
    }
    VtxConfiguration {
        Int id PK "e.g. 1"
        Vtx vtx FK "e.g. 107"
        String loadoutName "e.g. O3 with Dual Matchsticks"
    }
    ReceiverConfiguration {
        Int id PK "e.g. 1"
        Receiver receiver FK "e.g. 109"
        String loadoutName "e.g. ELRS Diversity Setup"
    }
    Build {
        Int id PK "e.g. 1"
        String name "e.g. Bando Basher 5 inch"
        Int crashResistanceRating "e.g. 9"
        String description "e.g. My main freestyle rig"
        Boolean isVerified "e.g. true"
        Float miscWeightG "e.g. 25.0"
        DateTime createdAt "e.g. 2026-09-26"
        Frame frame FK "e.g. 101"
        Motor motor FK "e.g. 102"
        Propeller propeller FK "e.g. 103"
        FlightController flightController FK "e.g. 104"
        Esc esc FK "e.g. 105"
        Camera camera FK "e.g. 108"
        Gps gps FK "e.g. 110"
        VtxConfiguration vtxConfig FK "e.g. 1"
        ReceiverConfiguration receiverConfig FK "e.g. 1"
    }

    FrameFcStackMount {
        Frame frame PK "e.g. 101"
        BoardMountPattern boardMountPattern PK "e.g. 30.5x30.5mm"
    }
    FrameVtxMount {
        Frame frame PK "e.g. 101"
        BoardMountPattern boardMountPattern PK "e.g. 25.5x25.5mm"
    }

    Component ||--|o HardwareComponent : "hardwareComponent"
    Component ||--|o SoftwareComponent : "softwareComponent"
    Component ||--o{ ComponentCompany : "companies"
    Company ||--o{ ComponentCompany : "components"
    Component ||--o{ ReferenceLink : "links"
    Company |o--o{ ReferenceLink : "links"

    IncompatibilityIssue ||--o{ IncompatibilityComponent : "components"
    Component ||--o{ IncompatibilityComponent : "flaggedInIssues"

    HardwareComponent ||--|o Frame : "frame"
    HardwareComponent ||--|o Motor : "motor"
    HardwareComponent ||--|o Propeller : "propeller"
    HardwareComponent ||--|o FlightController : "flightController"
    HardwareComponent ||--|o Esc : "esc"
    HardwareComponent ||--|o Battery : "battery"
    HardwareComponent ||--|o Vtx : "vtx"
    HardwareComponent ||--|o Camera : "camera"
    HardwareComponent ||--|o Receiver : "receiver"
    HardwareComponent ||--|o Gps : "gps"
    HardwareComponent ||--|o Transmitter : "transmitter"
    HardwareComponent ||--|o Goggles : "goggles"
    HardwareComponent ||--|o Antenna : "antenna"

    VtxConfiguration |o--o{ Build : "builds"
    ReceiverConfiguration |o--o{ Build : "builds"
    Build }o--o{ Tag : "tags"
    Frame ||--o{ Build : "builds"
    Motor ||--o{ Build : "builds"
    Propeller ||--o{ Build : "builds"
    FlightController ||--o{ Build : "builds"
    Esc |o--o{ Build : "builds"
    Camera ||--o{ Build : "builds"
    Gps |o--o{ Build : "builds"

    Vtx ||--o{ VtxConfiguration : "configs"
    Receiver ||--o{ ReceiverConfiguration : "configs"
    VtxConfiguration }o--o{ Antenna : "antennas"
    ReceiverConfiguration }o--o{ Antenna : "antennas"

    Frame ||--o{ FrameFcStackMount : "fcStackMounts"
    Frame ||--o{ FrameVtxMount : "vtxMounts"


    %% Software Specific Models
    FcFirmware {
        Int id PK "e.g. 1"
        SoftwareComponent softwareComponent FK
    }

    EscFirmware {
        Int id PK "e.g. 2"
        SoftwareComponent softwareComponent FK
    }

    OperatingSystem {
        Int id PK "e.g. 3"
        SoftwareComponent softwareComponent FK
    }

    Configurator {
        Int id PK "e.g. 4"
        SoftwareComponent softwareComponent FK
    }

    SoftwareComponent ||--|o FcFirmware : "fcFirmware"
    SoftwareComponent ||--|o EscFirmware : "escFirmware"
    SoftwareComponent ||--|o OperatingSystem : "os"
    SoftwareComponent ||--|o Configurator : "configurator"
