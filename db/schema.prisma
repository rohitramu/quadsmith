// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 0. USER & AUTHENTICATION
// ==========================================

enum UserRole {
  USER
  ADMIN
}

enum OAuthProvider {
  GOOGLE
  GITHUB
  DISCORD
  MICROSOFT
  META
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  username        String    @unique
  role            UserRole  @default(USER)
  emailVerifiedAt DateTime?
  lastRenamedAt   DateTime?
  deletedAt       DateTime?
  bannedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile         UserProfile?
  usernameHistory UsernameHistory[]
  oauthAccounts   OAuthAccount[]
  refreshTokens   RefreshToken[]

  builds           Build[]
  reviews          Review[]
  reviewVotes      ReviewVote[]
  reviewComments   ReviewComment[]
  questions        Question[]
  answers          Answer[]
  questionVotes    QuestionVote[]
  answerVotes      AnswerVote[]
  questionComments QuestionComment[]
  answerComments   AnswerComment[]
  reputation       UserReputation?
  collections      Collection[]
}

model UserProfile {
  userId      Int      @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  avatarUrl   String?
  updatedAt   DateTime @updatedAt
}

model UsernameHistory {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  oldUsername String
  renamedAt   DateTime @default(now())

  @@index([oldUsername, renamedAt])
}

model OAuthAccount {
  id                Int           @id @default(autoincrement())
  userId            Int
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          OAuthProvider
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  tokenExpiresAt    DateTime?
  createdAt         DateTime      @default(now())

  @@unique([provider, providerAccountId])
}

model EmailOtp {
  id             Int       @id @default(autoincrement())
  email          String
  codeHash       String
  expiresAt      DateTime
  usedAt         DateTime?
  failedAttempts Int       @default(0)
  createdAt      DateTime  @default(now())

  @@index([email, createdAt])
}

model RefreshToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String
  expiresAt  DateTime
  lastUsedAt DateTime?
  deviceHint String?
  createdAt  DateTime  @default(now())
}

// ==========================================
// 1. BASE INFRASTRUCTURE & LOOKUP TABLES
// ==========================================

model VtxEcosystem {
  id      String    @id
  vtxs    Vtx[]
  cameras Camera[]
  goggles Goggles[]
}

model RfFrequency {
  id           String        @id
  receivers    Receiver[]
  transmitters Transmitter[]
  goggles      Goggles[]
  vtxs         Vtx[]
  antennas     Antenna[]
}

model RfProtocol {
  id           String        @id
  receivers    Receiver[]
  transmitters Transmitter[]
}

model AntennaPolarization {
  id           String        @id
  vtxs         Vtx[]
  receivers    Receiver[]
  transmitters Transmitter[]
  goggles      Goggles[]
  antennas     Antenna[]
}

model AntennaConnector {
  id           String        @id
  vtxs         Vtx[]
  receivers    Receiver[]
  transmitters Transmitter[]
  goggles      Goggles[]
  antennas     Antenna[]
}

model BatteryConnector {
  id          String    @id
  maxCurrentA Decimal
  maxVoltageV Decimal
  batteries   Battery[]
}

model Tag {
  id          String  @id // e.g. "freestyle", "cinewhoop"
  description String?
  builds      Build[] // Implicit Many-to-Many
}

model MotorMountPattern {
  id     String  @id
  frames Frame[]
  motors Motor[]
}

model BoardMountPattern {
  id                String              @id
  fcStackFrames     FrameFcStackMount[]
  vtxMountFrames    FrameVtxMount[]
  flightControllers FlightController[]
  escs              Esc[]
  vtxs              Vtx[]
}

model BatteryChemistry {
  id                     Int       @id @default(autoincrement())
  name                   String
  nominalVoltagePerCellV Decimal
  maxVoltagePerCellV     Decimal
  minVoltagePerCellV     Decimal
  batteries              Battery[]
}

// ==========================================
// 2. HARDWARE COMPONENT (BASE ENTITY)
// ==========================================

model Company {
  id         Int     @id @default(autoincrement())
  name       String
  websiteUrl String?

  components     ComponentCompany[]
  referenceLinks ReferenceLink[]
}

model Component {
  id           Int    @id @default(autoincrement())
  name         String
  releaseYear  Int?
  releaseMonth Int?
  releaseDay   Int?

  companies       ComponentCompany[]
  referenceLinks  ReferenceLink[]
  flaggedInIssues IncompatibilityComponent[]

  hardwareComponent HardwareComponent?
  softwareComponent SoftwareComponent?

  reviews         Review[]
  questions       Question[]
  collectionItems CollectionItem[]
}

model HardwareComponent {
  id        Int       @id
  component Component @relation(fields: [id], references: [id], onDelete: Cascade)
  weightG   Decimal?

  // One-to-One relations for the specific component types
  frame                     Frame?
  motor                     Motor?
  propeller                 Propeller?
  flightController          FlightController?
  esc                       Esc?
  battery                   Battery?
  vtx                       Vtx?
  camera                    Camera?
  receiver                  Receiver?
  gps                       Gps?
  transmitter               Transmitter?
  goggles                   Goggles?
  antenna                   Antenna?
  incompatibilityComponents IncompatibilityComponent[]
}

model ComponentCompany {
  id          Int       @id @default(autoincrement())
  componentId Int
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model ReferenceLink {
  id          Int       @id @default(autoincrement())
  componentId Int
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  companyId   Int?
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  url         String
  linkType    String // e.g. "Purchase", "Manual", "Firmware"
  title       String
  description String?
}

// ==========================================
// 3. EXCEPTIONS & INCOMPATIBILITIES
// ==========================================

model IncompatibilityIssue {
  id                    Int                        @id @default(autoincrement())
  incompatibilityReason String                     // "Physical", "Noise", "Firmware"
  description           String
  suggestedFix          String?
  fixDifficulty         Int?                       // 1 (trivial) to 10 (extremely difficult)
  components            IncompatibilityComponent[]
}

model IncompatibilityComponent {
  issueId             Int
  issue               IncompatibilityIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  hardwareComponentId Int
  hardwareComponent   HardwareComponent    @relation(fields: [hardwareComponentId], references: [id], onDelete: Cascade)
  component           Component?           @relation(fields: [componentId], references: [id])
  componentId         Int?

  @@id([issueId, hardwareComponentId])
}

// ==========================================
// 4. HARDWARE SUB-TYPES (ONE-TO-ONE)
// ==========================================

model Frame {
  id                 Int                 @id
  component          HardwareComponent   @relation(fields: [id], references: [id], onDelete: Cascade)
  wheelbaseMm        Int
  maxPropSizeMm      Decimal
  fcStackMounts      FrameFcStackMount[]
  motorMountPatterns MotorMountPattern[]
  cameraMountWidthMm Decimal
  vtxMounts          FrameVtxMount[]
  maxBatteryLengthMm Decimal?
  maxBatteryWidthMm  Decimal?
  maxBatteryHeightMm Decimal?

  builds Build[]
}

model Motor {
  id               Int                 @id
  component        HardwareComponent   @relation(fields: [id], references: [id], onDelete: Cascade)
  statorSize       String
  kvRating         Int
  inputVoltageMinV Decimal
  inputVoltageMaxV Decimal
  mountPatterns    MotorMountPattern[]
  mountBoltSize    String
  shaftType        String
  maxCurrentA      Decimal?

  builds Build[]
}

model Propeller {
  id                Int               @id
  component         HardwareComponent @relation(fields: [id], references: [id], onDelete: Cascade)
  diameterMm        Decimal
  pitchMm           Decimal
  bladeCount        Int
  mountType         String
  recommendedStator String[]

  builds Build[]
}

model FlightController {
  id               Int                 @id
  component        HardwareComponent   @relation(fields: [id], references: [id], onDelete: Cascade)
  mountPatterns    BoardMountPattern[]
  boardHeightMm    Decimal
  mcuProcessor     String
  gyroSensor       String?
  inputVoltageMinV Decimal
  inputVoltageMaxV Decimal
  becOutputs       Json?
  uartConnections  Json?
  escInterface     String

  supportedFirmware FcFirmware[] // Implicit Many-to-Many

  flightStacks FlightStack[]
}

enum EscFormFactor {
  INTEGRATED_IN_FC
  FOUR_IN_ONE      @map("4-in-1")
  INDIVIDUAL       @map("Individual")
}

model Esc {
  id                 Int                 @id
  component          HardwareComponent   @relation(fields: [id], references: [id], onDelete: Cascade)
  formFactor         EscFormFactor
  mountPatterns      BoardMountPattern[]
  boardHeightMm      Decimal
  continuousCurrentA Decimal
  burstCurrentA      Decimal
  inputVoltageMinV   Decimal
  inputVoltageMaxV   Decimal

  supportedFirmware EscFirmware[] // Implicit Many-to-Many

  flightStacks FlightStack[]
}

model Battery {
  id                Int               @id
  component         HardwareComponent @relation(fields: [id], references: [id], onDelete: Cascade)
  chemistryId       Int
  chemistry         BatteryChemistry  @relation(fields: [chemistryId], references: [id])
  cellCountS        Int
  cellCountP        Int
  capacityMah       Int
  continuousCRating Int
  connectorTypeId   String
  connectorType     BatteryConnector  @relation(fields: [connectorTypeId], references: [id])
  lengthMm          Decimal?
  widthMm           Decimal?
  heightMm          Decimal?
}

model Vtx {
  id                      Int                 @id
  supportedFrequencies    RfFrequency[]
  component               HardwareComponent   @relation(fields: [id], references: [id], onDelete: Cascade)
  ecosystemId             String
  ecosystem               VtxEcosystem        @relation(fields: [ecosystemId], references: [id])
  videoConnectionStandard String?
  mountPatterns           BoardMountPattern[]
  boardHeightMm           Decimal
  inputVoltageMinV        Decimal
  inputVoltageMaxV        Decimal
  maxPowerMw              Int?

  antennaCount                  Int                  @default(1)
  antennaConnectorId            String?
  antennaConnector              AntennaConnector?    @relation(fields: [antennaConnectorId], references: [id])
  includedAntennaPolarizationId String?
  includedAntennaPolarization   AntennaPolarization? @relation(fields: [includedAntennaPolarizationId], references: [id])

  supportedFirmware VtxFirmware[] // Implicit Many-to-Many

  configs VtxConfiguration[]
}

model Camera {
  id                      Int               @id
  component               HardwareComponent @relation(fields: [id], references: [id], onDelete: Cascade)
  ecosystemId             String
  ecosystem               VtxEcosystem      @relation(fields: [ecosystemId], references: [id])
  videoConnectionStandard String?
  widthMm                 Decimal
  heightMm                Decimal
  depthMm                 Decimal
  inputVoltageMinV        Decimal
  inputVoltageMaxV        Decimal
  mountingScrewSize       String
  aspectRatio             String

  builds Build[]
}

model Receiver {
  id                   Int               @id
  supportedFrequencies RfFrequency[]
  component            HardwareComponent @relation(fields: [id], references: [id], onDelete: Cascade)
  rfProtocols          RfProtocol[]
  outputProtocol       String
  inputVoltageMinV     Decimal
  inputVoltageMaxV     Decimal

  antennaCount                  Int                  @default(1)
  antennaConnectorId            String?
  antennaConnector              AntennaConnector?    @relation(fields: [antennaConnectorId], references: [id])
  includedAntennaPolarizationId String?
  includedAntennaPolarization   AntennaPolarization? @relation(fields: [includedAntennaPolarizationId], references: [id])

  configs ReceiverConfiguration[]
}

model Gps {
  id               Int               @id
  component        HardwareComponent @relation(fields: [id], references: [id], onDelete: Cascade)
  chipset          String
  hasCompass       Boolean
  inputVoltageMinV Decimal
  inputVoltageMaxV Decimal
  lengthMm         Decimal?
  widthMm          Decimal?
  heightMm         Decimal?

  builds Build[]
}

model Antenna {
  id                   Int                 @id
  component            HardwareComponent   @relation(fields: [id], references: [id], onDelete: Cascade)
  supportedFrequencyId String
  supportedFrequency   RfFrequency         @relation(fields: [supportedFrequencyId], references: [id])
  polarizationId       String
  polarization         AntennaPolarization @relation(fields: [polarizationId], references: [id])
  connectorId          String
  connector            AntennaConnector    @relation(fields: [connectorId], references: [id])
  antennaStyle         String
  gainDbi              Decimal?
  cableLengthMm        Decimal?

  vtxConfigs      VtxConfiguration[]
  receiverConfigs ReceiverConfiguration[]
}

model Transmitter {
  id                   Int               @id
  supportedFrequencies RfFrequency[]
  component            HardwareComponent @relation(fields: [id], references: [id], onDelete: Cascade)
  rfProtocols          RfProtocol[]
  externalBayType      String

  antennaCount                  Int                  @default(1)
  antennaConnectorId            String?
  antennaConnector              AntennaConnector?    @relation(fields: [antennaConnectorId], references: [id])
  includedAntennaPolarizationId String?
  includedAntennaPolarization   AntennaPolarization? @relation(fields: [includedAntennaPolarizationId], references: [id])

  supportedOs OperatingSystem[] // Implicit Many-to-Many
}

model Goggles {
  id                   Int               @id
  supportedFrequencies RfFrequency[]
  component            HardwareComponent @relation(fields: [id], references: [id], onDelete: Cascade)
  ecosystemId          String
  ecosystem            VtxEcosystem      @relation(fields: [ecosystemId], references: [id])

  antennaCount                  Int                  @default(1)
  antennaConnectorId            String?
  antennaConnector              AntennaConnector?    @relation(fields: [antennaConnectorId], references: [id])
  includedAntennaPolarizationId String?
  includedAntennaPolarization   AntennaPolarization? @relation(fields: [includedAntennaPolarizationId], references: [id])
}

// ==========================================
// 5. SUB-ASSEMBLIES / LOADOUTS 
// ==========================================

model FlightStack {
  id                 Int              @id @default(autoincrement())
  flightControllerId Int
  flightController   FlightController @relation(fields: [flightControllerId], references: [id])
  escId              Int
  esc                Esc              @relation(fields: [escId], references: [id])
  loadoutName        String?

  builds Build[]
}

model VtxConfiguration {
  id          Int       @id @default(autoincrement())
  vtxId       Int
  vtx         Vtx       @relation(fields: [vtxId], references: [id])
  antennas    Antenna[] // Implicit Many-to-Many
  loadoutName String?

  builds Build[]
}

model ReceiverConfiguration {
  id          Int       @id @default(autoincrement())
  receiverId  Int
  receiver    Receiver  @relation(fields: [receiverId], references: [id])
  antennas    Antenna[] // Implicit Many-to-Many
  loadoutName String?

  builds Build[]
}

// ==========================================
// 6. CORE APPLICATION ENTITY (THE AIRCRAFT)
// ==========================================

model Build {
  id                    Int      @id @default(autoincrement())
  name                  String
  crashResistanceRating Int?
  description           String?
  isVerified            Boolean  @default(false)
  miscWeightG           Decimal?
  createdAt             DateTime @default(now())

  userId                Int?
  user                  User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)

  tags Tag[] // Implicit Many-to-Many

  // Hard Hardware Links
  frameId     Int
  frame       Frame     @relation(fields: [frameId], references: [id])
  motorId     Int
  motor       Motor     @relation(fields: [motorId], references: [id])
  propellerId Int
  propeller   Propeller @relation(fields: [propellerId], references: [id])
  cameraId    Int
  camera      Camera    @relation(fields: [cameraId], references: [id])
  gpsId       Int?
  gps         Gps?      @relation(fields: [gpsId], references: [id])

  // Sub-Assembly Links
  flightStackId    Int
  flightStack      FlightStack            @relation(fields: [flightStackId], references: [id])
  vtxConfigId      Int?
  vtxConfig        VtxConfiguration?      @relation(fields: [vtxConfigId], references: [id])
  receiverConfigId Int?
  receiverConfig   ReceiverConfiguration? @relation(fields: [receiverConfigId], references: [id])

  reviews         Review[]
  questions       Question[]
  collectionItems CollectionItem[]
}

model FrameFcStackMount {
  frame               Frame             @relation(fields: [frameId], references: [id], onDelete: Cascade)
  frameId             Int
  boardMountPattern   BoardMountPattern @relation(fields: [boardMountPatternId], references: [id], onDelete: Cascade)
  boardMountPatternId String

  @@id([frameId, boardMountPatternId])
}

model FrameVtxMount {
  frame               Frame             @relation(fields: [frameId], references: [id], onDelete: Cascade)
  frameId             Int
  boardMountPattern   BoardMountPattern @relation(fields: [boardMountPatternId], references: [id], onDelete: Cascade)
  boardMountPatternId String

  @@id([frameId, boardMountPatternId])
}

model Software {
  id          Int                 @id @default(autoincrement())
  name        String
  components  SoftwareComponent[]
}

model SoftwareComponent {
  id          Int       @id
  component   Component @relation(fields: [id], references: [id], onDelete: Cascade)
  
  softwareId  Int
  software    Software  @relation(fields: [softwareId], references: [id], onDelete: Cascade)
  
  version     String
  flavorTarget String?
  
  fcFirmware  FcFirmware?
  escFirmware EscFirmware?
  vtxFirmware VtxFirmware?
  os          OperatingSystem?
}

model FcFirmware {
  id                Int               @id
  softwareComponent SoftwareComponent @relation(fields: [id], references: [id], onDelete: Cascade)

  compatibleFlightControllers FlightController[] // Implicit Many-to-Many
}

model EscFirmware {
  id                Int               @id
  softwareComponent SoftwareComponent @relation(fields: [id], references: [id], onDelete: Cascade)

  compatibleEscs Esc[] // Implicit Many-to-Many
}

model VtxFirmware {
  id                Int               @id
  softwareComponent SoftwareComponent @relation(fields: [id], references: [id], onDelete: Cascade)

  compatibleVtxs Vtx[] // Implicit Many-to-Many
}

model OperatingSystem {
  id                Int               @id
  softwareComponent SoftwareComponent @relation(fields: [id], references: [id], onDelete: Cascade)

  compatibleTransmitters Transmitter[] // Implicit Many-to-Many
}

// ==========================================
// 7. SOCIAL INTERACTIONS, REPUTATION & COLLECTIONS
// ==========================================

// ------------------------------------------
// Reviews & Review Comments (Steam-Style)
// ------------------------------------------

model Review {
  id             Int             @id @default(autoincrement())
  userId         Int
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Polymorphic Target (Enforced via app logic & check constraint)
  buildId        Int?
  build          Build?          @relation(fields: [buildId], references: [id], onDelete: Cascade)
  componentId    Int?
  component      Component?      @relation(fields: [componentId], references: [id], onDelete: Cascade)

  isRecommended  Boolean
  body           String
  isEdited       Boolean         @default(false)
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  votes          ReviewVote[]
  comments       ReviewComment[]

  @@unique([userId, buildId])
  @@unique([userId, componentId])
  @@index([buildId, isRecommended])
  @@index([componentId, isRecommended])
}

model ReviewVote {
  id        Int      @id @default(autoincrement())
  reviewId  Int
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isHelpful Boolean  // true = Helpful, false = Unhelpful
  createdAt DateTime @default(now())

  @@unique([userId, reviewId])
}

model ReviewComment {
  id        Int       @id @default(autoincrement())
  reviewId  Int
  review    Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([reviewId, createdAt])
}

// ------------------------------------------
// Technical Q&A (StackOverflow-Style)
// ------------------------------------------

model Question {
  id          Int            @id @default(autoincrement())
  userId      Int
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Polymorphic Target
  buildId     Int?
  build       Build?         @relation(fields: [buildId], references: [id], onDelete: Cascade)
  componentId Int?
  component   Component?     @relation(fields: [componentId], references: [id], onDelete: Cascade)

  title       String
  body        String
  netScore    Int            @default(0) // Denormalized for fast sorting
  isEdited    Boolean        @default(false)
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  answers     Answer[]
  votes       QuestionVote[]
  comments    QuestionComment[]

  @@index([buildId, netScore])
  @@index([componentId, netScore])
}

model Answer {
  id                Int             @id @default(autoincrement())
  questionId        Int
  question          Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId            Int
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  body              String
  netScore          Int             @default(0) // Denormalized for fast sorting
  isAcceptedByAsker Boolean         @default(false) // Checkmark from Question Asker
  isAuthorEndorsed  Boolean         @default(false) // Star badge from Build Author
  isEdited          Boolean         @default(false)
  deletedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  votes             AnswerVote[]
  comments          AnswerComment[]

  @@index([questionId, netScore])
}

model QuestionVote {
  id         Int      @id @default(autoincrement())
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isUpvote   Boolean  // true = Upvote (+1), false = Downvote (-1)
  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
}

model AnswerVote {
  id        Int      @id @default(autoincrement())
  answerId  Int
  answer    Answer   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isUpvote  Boolean  // true = Upvote (+1), false = Downvote (-1)
  createdAt DateTime @default(now())

  @@unique([userId, answerId])
}

model QuestionComment {
  id         Int       @id @default(autoincrement())
  questionId Int
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body       String
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([questionId, createdAt])
}

model AnswerComment {
  id        Int       @id @default(autoincrement())
  answerId  Int
  answer    Answer    @relation(fields: [answerId], references: [id], onDelete: Cascade)
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([answerId, createdAt])
}

// ------------------------------------------
// Reputation & User Karma Ledger
// ------------------------------------------

model UserReputation {
  userId    Int      @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int      @default(0) // Total earned reputation (minimum 0)
  updatedAt DateTime @updatedAt
}

// ------------------------------------------
// Favorites & Collections
// ------------------------------------------

model Collection {
  id             Int              @id @default(autoincrement())
  userId         Int
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  isPublic       Boolean          @default(false)
  isDefaultLiked Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  items          CollectionItem[]

  @@index([userId, isDefaultLiked])
  @@index([userId, isPublic])
}

model CollectionItem {
  id           Int        @id @default(autoincrement())
  collectionId Int
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  // Polymorphic Target (Build or Component)
  buildId      Int?
  build        Build?     @relation(fields: [buildId], references: [id], onDelete: Cascade)
  componentId  Int?
  component    Component? @relation(fields: [componentId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())

  @@unique([collectionId, buildId])
  @@unique([collectionId, componentId])
}

