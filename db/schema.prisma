// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. BASE INFRASTRUCTURE & LOOKUP TABLES
// ==========================================

model VtxEcosystem {
  id      String    @id
  vtxs    Vtx[]
  cameras Camera[]
  goggles Goggles[]
}

model RfFrequency {
  id           String        @id
  receivers    Receiver[]
  transmitters Transmitter[]
  goggles      Goggles[]
  vtxs         Vtx[]
  antennas     Antenna[]
}

model RfProtocol {
  id           String        @id
  receivers    Receiver[]
  transmitters Transmitter[]
}

model AntennaPolarization {
  id           String        @id
  vtxs         Vtx[]
  receivers    Receiver[]
  transmitters Transmitter[]
  goggles      Goggles[]
  antennas     Antenna[]
}

model AntennaConnector {
  id           String        @id
  vtxs         Vtx[]
  receivers    Receiver[]
  transmitters Transmitter[]
  goggles      Goggles[]
  antennas     Antenna[]
}

model BatteryConnector {
  id          String    @id
  maxCurrentA Decimal
  maxVoltageV Decimal
  batteries   Battery[]
}

model Tag {
  id          String  @id // e.g. "freestyle", "cinewhoop"
  description String?
  builds      Build[] // Implicit Many-to-Many
}

model MotorMountPattern {
  id     String  @id
  frames Frame[]
  motors Motor[]
}

model BoardMountPattern {
  id                String              @id
  fcStackFrames     FrameFcStackMount[]
  vtxMountFrames    FrameVtxMount[]
  flightControllers FlightController[]
  escs              Esc[]
  vtxs              Vtx[]
}

model BatteryChemistry {
  id                     Int       @id @default(autoincrement())
  name                   String
  nominalVoltagePerCellV Decimal
  maxVoltagePerCellV     Decimal
  minVoltagePerCellV     Decimal
  batteries              Battery[]
}

// ==========================================
// 2. HARDWARE COMPONENT (BASE ENTITY)
// ==========================================

model Company {
  id         Int     @id @default(autoincrement())
  name       String
  websiteUrl String?

  components     ComponentCompany[]
  referenceLinks ReferenceLink[]
}

model Component {
  id           Int    @id @default(autoincrement())
  name         String
  releaseYear  Int?
  releaseMonth Int?
  releaseDay   Int?

  companies       ComponentCompany[]
  referenceLinks  ReferenceLink[]
  flaggedInIssues IncompatibilityComponent[]

  hardwareComponent HardwareComponent?
  softwareComponent SoftwareComponent?
}

model HardwareComponent {
  id        Int       @id
  component Component @relation(fields: [id], references: [id], onDelete: Cascade)
  weightG   Decimal?

  // One-to-One relations for the specific component types
  frame                     Frame?
  motor                     Motor?
  propeller                 Propeller?
  flightController          FlightController?
  esc                       Esc?
  battery                   Battery?
  vtx                       Vtx?
  camera                    Camera?
  receiver                  Receiver?
  gps                       Gps?
  transmitter               Transmitter?
  goggles                   Goggles?
  antenna                   Antenna?
  incompatibilityComponents IncompatibilityComponent[]
}

model ComponentCompany {
  id          Int       @id @default(autoincrement())
  componentId Int
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model ReferenceLink {
  id          Int       @id @default(autoincrement())
  componentId Int
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  companyId   Int?
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  url         String
  linkType    String // e.g. "Purchase", "Manual", "Firmware"
  title       String
  description String?
}

// ==========================================
// 3. EXCEPTIONS & INCOMPATIBILITIES
// ==========================================

model IncompatibilityIssue {
  id                    Int                        @id @default(autoincrement())
  incompatibilityReason String // "Physical", "Noise", "Firmware"
  description           String
  suggestedFix          String?
  components            IncompatibilityComponent[]
}

model IncompatibilityComponent {
  issueId             Int
  issue               IncompatibilityIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  hardwareComponentId Int
  hardwareComponent   HardwareComponent    @relation(fields: [hardwareComponentId], references: [id], onDelete: Cascade)
  component           Component?           @relation(fields: [componentId], references: [id])
  componentId         Int?

  @@id([issueId, hardwareComponentId])
}

// ==========================================
// 4. HARDWARE SUB-TYPES (ONE-TO-ONE)
// ==========================================

model Frame {
  id                 Int                 @id
  component          HardwareComponent   @relation(fields: [id], references: [id], onDelete: Cascade)
  wheelbaseMm        Int
  maxPropSizeMm      Decimal
  fcStackMounts      FrameFcStackMount[]
  motorMountPatterns MotorMountPattern[]
  cameraMountWidthMm Decimal
  vtxMounts          FrameVtxMount[]
  maxBatteryLengthMm Decimal?
  maxBatteryWidthMm  Decimal?
  maxBatteryHeightMm Decimal?

  builds Build[]
}

model Motor {
  id               Int                 @id
  component        HardwareComponent   @relation(fields: [id], references: [id], onDelete: Cascade)
  statorSize       String
  kvRating         Int
  inputVoltageMinV Decimal
  inputVoltageMaxV Decimal
  mountPatterns    MotorMountPattern[]
  mountBoltSize    String
  shaftType        String
  maxCurrentA      Decimal?

  builds Build[]
}

model Propeller {
  id                Int               @id
  component         HardwareComponent @relation(fields: [id], references: [id], onDelete: Cascade)
  diameterMm        Decimal
  pitchMm           Decimal
  bladeCount        Int
  mountType         String
  recommendedStator String[]

  builds Build[]
}

model FlightController {
  id               Int                 @id
  component        HardwareComponent   @relation(fields: [id], references: [id], onDelete: Cascade)
  mountPatterns    BoardMountPattern[]
  boardHeightMm    Decimal
  mcuProcessor     String
  gyroSensor       String?
  inputVoltageMinV Decimal
  inputVoltageMaxV Decimal
  becOutputs       Json?
  uartConnections  Json?
  escInterface     String

  supportedFirmware FcFirmware[] // Implicit Many-to-Many

  builds Build[]
}

model Esc {
  id                 Int                 @id
  component          HardwareComponent   @relation(fields: [id], references: [id], onDelete: Cascade)
  isIntegrated       Boolean // True if AIO
  formFactor         String
  mountPatterns      BoardMountPattern[]
  boardHeightMm      Decimal
  continuousCurrentA Decimal
  burstCurrentA      Decimal
  inputVoltageMinV   Decimal
  inputVoltageMaxV   Decimal

  supportedFirmware EscFirmware[] // Implicit Many-to-Many

  builds Build[]
}

model Battery {
  id                Int               @id
  component         HardwareComponent @relation(fields: [id], references: [id], onDelete: Cascade)
  chemistryId       Int
  chemistry         BatteryChemistry  @relation(fields: [chemistryId], references: [id])
  cellCountS        Int
  cellCountP        Int
  capacityMah       Int
  continuousCRating Int
  connectorTypeId   String
  connectorType     BatteryConnector  @relation(fields: [connectorTypeId], references: [id])
  lengthMm          Decimal?
  widthMm           Decimal?
  heightMm          Decimal?
}

model Vtx {
  id                      Int                 @id
  supportedFrequencies    RfFrequency[]
  component               HardwareComponent   @relation(fields: [id], references: [id], onDelete: Cascade)
  ecosystemId             String
  ecosystem               VtxEcosystem        @relation(fields: [ecosystemId], references: [id])
  videoConnectionStandard String?
  mountPatterns           BoardMountPattern[]
  boardHeightMm           Decimal
  inputVoltageMinV        Decimal
  inputVoltageMaxV        Decimal
  maxPowerMw              Int?

  antennaCount                  Int                  @default(1)
  antennaConnectorId            String?
  antennaConnector              AntennaConnector?    @relation(fields: [antennaConnectorId], references: [id])
  includedAntennaPolarizationId String?
  includedAntennaPolarization   AntennaPolarization? @relation(fields: [includedAntennaPolarizationId], references: [id])

  supportedFirmware VtxFirmware[] // Implicit Many-to-Many

  configs VtxConfiguration[]
}

model Camera {
  id                      Int               @id
  component               HardwareComponent @relation(fields: [id], references: [id], onDelete: Cascade)
  ecosystemId             String
  ecosystem               VtxEcosystem      @relation(fields: [ecosystemId], references: [id])
  videoConnectionStandard String?
  widthMm                 Decimal
  heightMm                Decimal
  depthMm                 Decimal
  inputVoltageMinV        Decimal
  inputVoltageMaxV        Decimal
  mountingScrewSize       String
  aspectRatio             String

  builds Build[]
}

model Receiver {
  id                   Int               @id
  supportedFrequencies RfFrequency[]
  component            HardwareComponent @relation(fields: [id], references: [id], onDelete: Cascade)
  rfProtocols          RfProtocol[]
  outputProtocol       String
  inputVoltageMinV     Decimal
  inputVoltageMaxV     Decimal

  antennaCount                  Int                  @default(1)
  antennaConnectorId            String?
  antennaConnector              AntennaConnector?    @relation(fields: [antennaConnectorId], references: [id])
  includedAntennaPolarizationId String?
  includedAntennaPolarization   AntennaPolarization? @relation(fields: [includedAntennaPolarizationId], references: [id])

  configs ReceiverConfiguration[]
}

model Gps {
  id               Int               @id
  component        HardwareComponent @relation(fields: [id], references: [id], onDelete: Cascade)
  chipset          String
  hasCompass       Boolean
  inputVoltageMinV Decimal
  inputVoltageMaxV Decimal
  lengthMm         Decimal?
  widthMm          Decimal?
  heightMm         Decimal?

  builds Build[]
}

model Antenna {
  id                   Int                 @id
  component            HardwareComponent   @relation(fields: [id], references: [id], onDelete: Cascade)
  supportedFrequencyId String
  supportedFrequency   RfFrequency         @relation(fields: [supportedFrequencyId], references: [id])
  polarizationId       String
  polarization         AntennaPolarization @relation(fields: [polarizationId], references: [id])
  connectorId          String
  connector            AntennaConnector    @relation(fields: [connectorId], references: [id])
  antennaStyle         String
  gainDbi              Decimal?
  cableLengthMm        Decimal?

  vtxConfigs      VtxConfiguration[]
  receiverConfigs ReceiverConfiguration[]
}

model Transmitter {
  id                   Int               @id
  supportedFrequencies RfFrequency[]
  component            HardwareComponent @relation(fields: [id], references: [id], onDelete: Cascade)
  rfProtocols          RfProtocol[]
  externalBayType      String

  antennaCount                  Int                  @default(1)
  antennaConnectorId            String?
  antennaConnector              AntennaConnector?    @relation(fields: [antennaConnectorId], references: [id])
  includedAntennaPolarizationId String?
  includedAntennaPolarization   AntennaPolarization? @relation(fields: [includedAntennaPolarizationId], references: [id])

  supportedOs OperatingSystem[] // Implicit Many-to-Many
}

model Goggles {
  id                   Int               @id
  supportedFrequencies RfFrequency[]
  component            HardwareComponent @relation(fields: [id], references: [id], onDelete: Cascade)
  ecosystemId          String
  ecosystem            VtxEcosystem      @relation(fields: [ecosystemId], references: [id])

  antennaCount                  Int                  @default(1)
  antennaConnectorId            String?
  antennaConnector              AntennaConnector?    @relation(fields: [antennaConnectorId], references: [id])
  includedAntennaPolarizationId String?
  includedAntennaPolarization   AntennaPolarization? @relation(fields: [includedAntennaPolarizationId], references: [id])
}

// ==========================================
// 5. SUB-ASSEMBLIES / LOADOUTS 
// ==========================================

model VtxConfiguration {
  id          Int       @id @default(autoincrement())
  vtxId       Int
  vtx         Vtx       @relation(fields: [vtxId], references: [id])
  antennas    Antenna[] // Implicit Many-to-Many
  loadoutName String?

  builds Build[]
}

model ReceiverConfiguration {
  id          Int       @id @default(autoincrement())
  receiverId  Int
  receiver    Receiver  @relation(fields: [receiverId], references: [id])
  antennas    Antenna[] // Implicit Many-to-Many
  loadoutName String?

  builds Build[]
}

// ==========================================
// 6. CORE APPLICATION ENTITY (THE AIRCRAFT)
// ==========================================

model Build {
  id                    Int      @id @default(autoincrement())
  name                  String
  crashResistanceRating Int?
  description           String?
  isVerified            Boolean  @default(false)
  miscWeightG           Decimal?
  createdAt             DateTime @default(now())

  tags Tag[] // Implicit Many-to-Many

  // Hard Hardware Links
  frameId            Int
  frame              Frame            @relation(fields: [frameId], references: [id])
  motorId            Int
  motor              Motor            @relation(fields: [motorId], references: [id])
  propellerId        Int
  propeller          Propeller        @relation(fields: [propellerId], references: [id])
  flightControllerId Int
  flightController   FlightController @relation(fields: [flightControllerId], references: [id])
  escId              Int?
  esc                Esc?             @relation(fields: [escId], references: [id])
  cameraId           Int
  camera             Camera           @relation(fields: [cameraId], references: [id])
  gpsId              Int?
  gps                Gps?             @relation(fields: [gpsId], references: [id])

  // Sub-Assembly Links
  vtxConfigId      Int?
  vtxConfig        VtxConfiguration?      @relation(fields: [vtxConfigId], references: [id])
  receiverConfigId Int?
  receiverConfig   ReceiverConfiguration? @relation(fields: [receiverConfigId], references: [id])
}

model FrameFcStackMount {
  frame               Frame             @relation(fields: [frameId], references: [id], onDelete: Cascade)
  frameId             Int
  boardMountPattern   BoardMountPattern @relation(fields: [boardMountPatternId], references: [id], onDelete: Cascade)
  boardMountPatternId String

  @@id([frameId, boardMountPatternId])
}

model FrameVtxMount {
  frame               Frame             @relation(fields: [frameId], references: [id], onDelete: Cascade)
  frameId             Int
  boardMountPattern   BoardMountPattern @relation(fields: [boardMountPatternId], references: [id], onDelete: Cascade)
  boardMountPatternId String

  @@id([frameId, boardMountPatternId])
}

model SoftwareComponent {
  id        Int       @id
  component Component @relation(fields: [id], references: [id], onDelete: Cascade)

  version String?

  fcFirmware  FcFirmware?
  escFirmware EscFirmware?
  vtxFirmware VtxFirmware?
  os          OperatingSystem?
}

model FcFirmware {
  id                Int               @id
  softwareComponent SoftwareComponent @relation(fields: [id], references: [id], onDelete: Cascade)

  compatibleFlightControllers FlightController[] // Implicit Many-to-Many
}

model EscFirmware {
  id                Int               @id
  softwareComponent SoftwareComponent @relation(fields: [id], references: [id], onDelete: Cascade)

  compatibleEscs Esc[] // Implicit Many-to-Many
}

model VtxFirmware {
  id                Int               @id
  softwareComponent SoftwareComponent @relation(fields: [id], references: [id], onDelete: Cascade)

  compatibleVtxs Vtx[] // Implicit Many-to-Many
}

model OperatingSystem {
  id                Int               @id
  softwareComponent SoftwareComponent @relation(fields: [id], references: [id], onDelete: Cascade)

  compatibleTransmitters Transmitter[] // Implicit Many-to-Many
}
