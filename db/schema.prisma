// This is your Prisma schema file,
// Redesigned with Postgres + JSONB + Protobuf Architecture:
// - Hardware and Software specifications are defined via Protobuf contracts and stored in Component.data (JSONB)
// - Eliminates brittle subtype tables and zero-DDL migrations for hardware specs
// - Full relational integrity for Users, Builds, Sub-Assemblies, Lookups, and Community ChangeRequests

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. GLOBAL NODE & CHANGE REQUESTS
// ==========================================

enum ResourceType {
  COMPONENT
  BUILD
  SOFTWARE_FAMILY
  COMPANY
  INCOMPATIBILITY_ISSUE
  // Lookup tables (Managed Dictionaries)
  VTX_ECOSYSTEM
  RF_FREQUENCY
  RF_PROTOCOL
  ANTENNA_POLARIZATION
  ANTENNA_CONNECTOR
  BATTERY_CONNECTOR
  TAG
  MOTOR_MOUNT_PATTERN
  BOARD_MOUNT_PATTERN
  BATTERY_CHEMISTRY
}

enum ComponentType {
  FRAME
  MOTOR
  PROPELLER
  FLIGHT_CONTROLLER
  ESC
  BATTERY
  VTX
  CAMERA
  RECEIVER
  GPS
  ANTENNA
  TRANSMITTER
  GOGGLES
  SOFTWARE_COMPONENT
}

model Resource {
  id           String       @id @default(uuid(7))
  resourceType ResourceType
  createdAt    DateTime     @default(now())

  // Entities
  component             Component?
  build                 Build?
  softwareFamily        Software?
  company               Company?
  incompatibilityIssue  IncompatibilityIssue?
  
  // Lookups
  vtxEcosystem          VtxEcosystem?
  rfFrequency           RfFrequency?
  rfProtocol            RfProtocol?
  antennaPolarization   AntennaPolarization?
  antennaConnector      AntennaConnector?
  batteryConnector      BatteryConnector?
  tag                   Tag?
  motorMountPattern     MotorMountPattern?
  boardMountPattern     BoardMountPattern?
  batteryChemistry      BatteryChemistry?

  // Social & Community Features 
  reviews               Review[]
  questions             Question[]
  collectionItems       CollectionItem[]
  
  // Community Moderation
  changeRequests        ChangeRequest[]
}

enum EditAction {
  CREATE
  UPDATE
  DELETE
}

model ChangeRequest {
  id              String          @id @default(uuid(7))
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  componentId     String?         // Targeted component for UPDATE / DELETE
  component       Component?      @relation(fields: [componentId], references: [id], onDelete: Cascade)

  resourceId      String?         // NULL if proposing a brand new resource
  resource        Resource?       @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  
  targetType      ResourceType    // ResourceType enum
  componentType   ComponentType?  // Specific ComponentType if modifying a component
  
  action          EditAction
  proposedData    Json?           // Holds the Protobuf JSON payload
  updateMask      String[]        // FieldMask paths, e.g. ["profile.motor.kvRating"]
  rationale       String?
  status          String          @default("PENDING") // PENDING, APPROVED, REJECTED, MERGED
  
  mergedIntoId    String?
  mergedInto      ChangeRequest?  @relation("MergedRequests", fields: [mergedIntoId], references: [id])
  mergedFrom      ChangeRequest[] @relation("MergedRequests")
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  votes           ChangeRequestVote[]
}

model ChangeRequestVote {
  id             String        @id @default(uuid(7))
  requestId      String
  request        ChangeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  isUpvote       Boolean  
  createdAt      DateTime      @default(now())

  @@unique([userId, requestId])
}


// ==========================================
// 2. USER & AUTHENTICATION
// ==========================================

enum UserRole {
  USER
  ADMIN
}

enum OAuthProvider {
  GOOGLE
  GITHUB
  DISCORD
  MICROSOFT
  META
}

model User {
  id              String       @id @default(uuid(7))
  email           String    @unique
  username        String    @unique
  role            UserRole  @default(USER)
  emailVerifiedAt DateTime?
  lastRenamedAt   DateTime?
  deletedAt       DateTime?
  bannedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile         UserProfile?
  usernameHistory UsernameHistory[]
  oauthAccounts   OAuthAccount[]
  refreshTokens   RefreshToken[]

  builds           Build[]
  reviews          Review[]
  reviewVotes      ReviewVote[]
  reviewComments   ReviewComment[]
  questions        Question[]
  answers          Answer[]
  questionVotes    QuestionVote[]
  answerVotes      AnswerVote[]
  questionComments QuestionComment[]
  answerComments   AnswerComment[]
  reputation       UserReputation?
  collections      Collection[]
  changeRequests   ChangeRequest[]
  changeVotes      ChangeRequestVote[]
}

model UserProfile {
  userId      String       @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  avatarUrl   String?
  updatedAt   DateTime @updatedAt
}

model UsernameHistory {
  id          String       @id @default(uuid(7))
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  oldUsername String
  renamedAt   DateTime @default(now())

  @@index([oldUsername, renamedAt])
}

model OAuthAccount {
  id                String       @id @default(uuid(7))
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          OAuthProvider
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  tokenExpiresAt    DateTime?
  createdAt         DateTime      @default(now())

  @@unique([provider, providerAccountId])
}

model EmailOtp {
  id             String       @id @default(uuid(7))
  email          String
  codeHash       String
  expiresAt      DateTime
  usedAt         DateTime?
  failedAttempts Int       @default(0)
  createdAt      DateTime  @default(now())

  @@index([email, createdAt])
}

model RefreshToken {
  id         String       @id @default(uuid(7))
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String
  expiresAt  DateTime
  lastUsedAt DateTime?
  deviceHint String?
  createdAt  DateTime  @default(now())
}

model UserReputation {
  userId String  @id
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  score  Int  @default(0)
}


// ==========================================
// 3. LOOKUP TABLES (MANAGED DICTIONARIES)
// ==========================================

model VtxEcosystem {
  id       String       @id
  resource Resource  @relation(fields: [id], references: [id], onDelete: Cascade)
  name     String    @unique
}

model RfFrequency {
  id           String       @id
  resource     Resource      @relation(fields: [id], references: [id], onDelete: Cascade)
  name         String        @unique
}

model RfProtocol {
  id           String       @id
  resource     Resource      @relation(fields: [id], references: [id], onDelete: Cascade)
  name         String        @unique
}

model AntennaPolarization {
  id           String       @id
  resource     Resource      @relation(fields: [id], references: [id], onDelete: Cascade)
  name         String        @unique
}

model AntennaConnector {
  id           String       @id
  resource     Resource      @relation(fields: [id], references: [id], onDelete: Cascade)
  name         String        @unique
}

model BatteryConnector {
  id          String       @id
  resource    Resource  @relation(fields: [id], references: [id], onDelete: Cascade)
  name        String    @unique
  maxCurrentA Decimal
  maxVoltageV Decimal
}

model Tag {
  id          String       @id
  resource    Resource @relation(fields: [id], references: [id], onDelete: Cascade)
  name        String   @unique
  description String?
  builds      Build[] 
}

model MotorMountPattern {
  id       String       @id
  resource Resource @relation(fields: [id], references: [id], onDelete: Cascade)
  name     String   @unique
}

model BoardMountPattern {
  id                String       @id
  resource          Resource            @relation(fields: [id], references: [id], onDelete: Cascade)
  name              String              @unique
}

model BatteryChemistry {
  id                     String       @id
  resource               Resource  @relation(fields: [id], references: [id], onDelete: Cascade)
  name                   String    @unique
  nominalVoltagePerCellV Decimal
  maxVoltagePerCellV     Decimal
  minVoltagePerCellV     Decimal
}


// ==========================================
// 4. COMPONENT IDENTITY & HARDWARE PROFILES
// ==========================================

model Company {
  id         String       @id
  resource   Resource @relation(fields: [id], references: [id], onDelete: Cascade)
  name       String   @unique
  websiteUrl String?

  components     ComponentCompany[]
  referenceLinks ReferenceLink[]
}

model Component {
  id              String          @id
  resource        Resource        @relation(fields: [id], references: [id], onDelete: Cascade)
  
  type            ComponentType
  name            String
  releaseYear     Int?
  releaseMonth    Int?
  releaseDay      Int?

  // The Protobuf payload storing all hardware/software specifications (JSONB)
  data            Json

  companies       ComponentCompany[]
  referenceLinks  ReferenceLink[]
  flaggedInIssues IncompatibilityComponent[]

  // Reusable sub-assembly and build linkages
  buildsAsFrame        Build[]                 @relation("BuildFrame")
  buildsAsMotor        Build[]                 @relation("BuildMotor")
  buildsAsPropeller    Build[]                 @relation("BuildPropeller")
  buildsAsCamera       Build[]                 @relation("BuildCamera")
  buildsAsGps          Build[]                 @relation("BuildGps")
  flightStacksAsFc     FlightStack[]           @relation("FlightStackFc")
  flightStacksAsEsc    FlightStack[]           @relation("FlightStackEsc")
  vtxConfigsAsVtx      VtxConfiguration[]      @relation("VtxConfigVtx")
  vtxConfigsAsAntenna  VtxConfiguration[]      @relation("VtxConfigAntennas")
  rxConfigsAsRx        ReceiverConfiguration[] @relation("RxConfigRx")
  rxConfigsAsAntenna   ReceiverConfiguration[] @relation("RxConfigAntennas")

  changeRequests       ChangeRequest[]
}

model ComponentCompany {
  id          String       @id @default(uuid(7))
  componentId String
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model ReferenceLink {
  id          String       @id @default(uuid(7))
  componentId String
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  url         String
  linkType    String // "Purchase", "Manual", "Firmware", "Datasheet"
  title       String
  description String?
}


// ==========================================
// 5. SOFTWARE HIERARCHY
// ==========================================

model Software {
  id          String       @id
  resource    Resource            @relation(fields: [id], references: [id], onDelete: Cascade)
  name        String              // e.g., "Betaflight"
}


// ==========================================
// 6. EXCEPTIONS & INCOMPATIBILITIES
// ==========================================

model IncompatibilityIssue {
  id                    String       @id
  resource              Resource                   @relation(fields: [id], references: [id], onDelete: Cascade)
  incompatibilityReason String                     // "Physical", "Noise", "Firmware"
  description           String
  suggestedFix          String?
  fixDifficulty         Int?                       // 1 (trivial) to 10 (extremely difficult)
  components            IncompatibilityComponent[]
}

model IncompatibilityComponent {
  issueId     String
  issue       IncompatibilityIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  componentId String
  component   Component            @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@id([issueId, componentId])
}


// ==========================================
// 7. SUB-ASSEMBLIES / LOADOUTS (AGGREGATES)
// ==========================================

model FlightStack {
  id                 String       @id @default(uuid(7))
  flightControllerId String
  flightController   Component    @relation("FlightStackFc", fields: [flightControllerId], references: [id])
  escId              String
  esc                Component    @relation("FlightStackEsc", fields: [escId], references: [id])
  loadoutName        String?

  builds Build[]
}

model VtxConfiguration {
  id          String       @id @default(uuid(7))
  vtxId       String
  vtx         Component    @relation("VtxConfigVtx", fields: [vtxId], references: [id])
  antennas    Component[]  @relation("VtxConfigAntennas")
  loadoutName String?

  builds Build[]
}

model ReceiverConfiguration {
  id          String       @id @default(uuid(7))
  receiverId  String
  receiver    Component    @relation("RxConfigRx", fields: [receiverId], references: [id])
  antennas    Component[]  @relation("RxConfigAntennas")
  loadoutName String?

  builds Build[]
}


// ==========================================
// 8. THE AIRCRAFT (BUILD)
// ==========================================

model Build {
  id                    String       @id
  resource              Resource @relation(fields: [id], references: [id], onDelete: Cascade)
  
  name                  String
  crashResistanceRating Int?
  description           String?
  isVerified            Boolean  @default(false)
  miscWeightG           Decimal?

  userId                String?
  user                  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  tags                  Tag[] 

  // Hard Hardware Links to Components
  frameId               String
  frame                 Component @relation("BuildFrame", fields: [frameId], references: [id])
  motorId               String
  motor                 Component @relation("BuildMotor", fields: [motorId], references: [id])
  propellerId           String
  propeller             Component @relation("BuildPropeller", fields: [propellerId], references: [id])
  cameraId              String
  camera                Component @relation("BuildCamera", fields: [cameraId], references: [id])
  gpsId                 String?
  gps                   Component? @relation("BuildGps", fields: [gpsId], references: [id])

  // Sub-Assembly Links
  flightStackId         String
  flightStack           FlightStack            @relation(fields: [flightStackId], references: [id])
  vtxConfigId           String?
  vtxConfig             VtxConfiguration?      @relation(fields: [vtxConfigId], references: [id])
  receiverConfigId      String?
  receiverConfig        ReceiverConfiguration? @relation(fields: [receiverConfigId], references: [id])
}


// ==========================================
// 9. SOCIAL INTERACTIONS & COLLECTIONS
// ==========================================

model Review {
  id             String       @id @default(uuid(7))
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Universal target
  resourceId     String
  resource       Resource        @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  isRecommended  Boolean
  body           String
  isEdited       Boolean         @default(false)
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  votes          ReviewVote[]
  comments       ReviewComment[]

  @@unique([userId, resourceId])
  @@index([resourceId, isRecommended])
}

model ReviewVote {
  id        String       @id @default(uuid(7))
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isHelpful Boolean  
  createdAt DateTime @default(now())

  @@unique([userId, reviewId])
}

model ReviewComment {
  id        String       @id @default(uuid(7))
  reviewId  String
  review    Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([reviewId, createdAt])
}

model Question {
  id          String       @id @default(uuid(7))
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Universal target
  resourceId  String
  resource    Resource       @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  title       String
  body        String
  netScore    Int            @default(0) 
  isEdited    Boolean        @default(false)
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  answers     Answer[]
  votes       QuestionVote[]
  comments    QuestionComment[]

  @@index([resourceId, netScore])
}

model Answer {
  id                String       @id @default(uuid(7))
  questionId        String
  question          Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  body              String
  netScore          Int             @default(0) 
  isAcceptedByAsker Boolean         @default(false) 
  isAuthorEndorsed  Boolean         @default(false) 
  isEdited          Boolean         @default(false)
  deletedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  votes             AnswerVote[]
  comments          AnswerComment[]

  @@index([questionId, netScore])
}

model QuestionVote {
  id         String       @id @default(uuid(7))
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isUpvote   Boolean  
  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
}

model AnswerVote {
  id        String       @id @default(uuid(7))
  answerId  String
  answer    Answer   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isUpvote  Boolean  
  createdAt DateTime @default(now())

  @@unique([userId, answerId])
}

model QuestionComment {
  id         String       @id @default(uuid(7))
  questionId String
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body       String
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model AnswerComment {
  id         String       @id @default(uuid(7))
  answerId   String
  answer     Answer    @relation(fields: [answerId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body       String
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Collection {
  id          String       @id @default(uuid(7))
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isPublic    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  items       CollectionItem[]
}

model CollectionItem {
  id           String       @id @default(uuid(7))
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  
  // Universal target
  resourceId   String
  resource     Resource   @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  addedAt      DateTime   @default(now())

  @@unique([collectionId, resourceId])
}
